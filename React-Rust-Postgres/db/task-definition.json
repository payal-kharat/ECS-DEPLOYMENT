{
  "containerDefinitions": [
    {
      "name": "db",
      "image": "mariadb:10-focal",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 5432,
          "hostPort": 5432,
          "protocol": "tcp",
          "name": "mysql"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "POSTGRES_PASSWORD",
          "value": "mysecretpassword"
        },
        {
          "name": "PGDATA",
          "value": "/var/lib/postgresql/data/pgdata"
        },
        {
          "name": "POSTGRES_DB",
          "value": "mysql"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": []
    }
  ],
  "family": "APP-4-dev-db",
  "executionRoleArn": "arn:aws:iam::552940445807:role/APP-4-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
  
}
