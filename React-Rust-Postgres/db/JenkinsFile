
pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select environment'
        )

        string(
            name: 'DEV_IMAGE_TAG',
            defaultValue: '',
            description: 'Enter the DEV image tag to promote, e.g. DEV-def5678'
        )
    }

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        DB_REPOSITORY = 'app-4-db'

        BUILD_CONTEXT =
            './React-Rust-Postgres/db'

        TASK_DEFINITION_TEMPLATE =
            './React-Rust-Postgres/db/task-definition.json'
    }

    stages {

        stage('DEV - Build Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    def commitId = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()

                    def imageTag =
                        "DEV-${commitId}"

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DB_REPOSITORY}:${imageTag}"

                    echo "======================================"
                    echo "ENVIRONMENT = dev"
                    echo "IMAGE TAG   = ${imageTag}"
                    echo "IMAGE URI   = ${imageUri}"
                    echo "======================================"

                    env.IMAGE_URI = imageUri

                    echo "Building DB Docker image..."

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:aws-ecr-credentials"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }

                    echo "Docker image build completed successfully."
                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }

        stage('DEV - Push Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    if (!env.IMAGE_URI?.trim()) {

                        error(
                            "IMAGE_URI is empty. " +
                            "Make sure the DEV - Build Image stage completed successfully."
                        )
                    }

                    echo "Pushing DB Docker image..."
                    echo "IMAGE URI = ${env.IMAGE_URI}"

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:aws-ecr-credentials"
                    ) {

                        docker.image(env.IMAGE_URI).push()
                    }

                    echo "Docker image pushed successfully."
                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }

        stage('QA - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }

            steps {

                script {

                    def sourceTag = params.DEV_IMAGE_TAG

                    if (!sourceTag?.trim()) {
                        error(
                            "DEV_IMAGE_TAG is required when promoting to QA."
                        )
                    }

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.DB_REPOSITORY}:${sourceTag}"

                    def targetTag =
                        "QA-${sourceTag.replaceFirst('^DEV-', '')}"

                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.DB_REPOSITORY}:${targetTag}"

                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET IMAGE = ${targetImage}"

                    sh """
                        set -e

                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}

                        echo "Pulling DEV image..."

                        docker pull ${sourceImage}

                        echo "Tagging image for QA..."

                        docker tag \
                            ${sourceImage} \
                            ${targetImage}

                        echo "Pushing QA image..."

                        docker push ${targetImage}
                    """

                    env.IMAGE_URI = targetImage

                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }

        stage('UAT - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }

            steps {

                script {

                    def sourceTag = params.DEV_IMAGE_TAG

                    if (!sourceTag?.trim()) {
                        error(
                            "DEV_IMAGE_TAG is required when promoting to UAT."
                        )
                    }

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.DB_REPOSITORY}:${sourceTag}"

                    def targetTag =
                        "UAT-${sourceTag.replaceFirst('^DEV-', '')}"

                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.DB_REPOSITORY}:${targetTag}"

                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET IMAGE = ${targetImage}"

                    sh """
                        set -e

                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}

                        echo "Pulling DEV image..."

                        docker pull ${sourceImage}

                        echo "Tagging image for UAT..."

                        docker tag \
                            ${sourceImage} \
                            ${targetImage}

                        echo "Pushing UAT image..."

                        docker push ${targetImage}
                    """

                    env.IMAGE_URI = targetImage

                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }

        stage('PROD - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                script {

                    def sourceTag = params.DEV_IMAGE_TAG

                    if (!sourceTag?.trim()) {
                        error(
                            "DEV_IMAGE_TAG is required when promoting to PROD."
                        )
                    }

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.DB_REPOSITORY}:${sourceTag}"

                    def targetTag =
                        "PROD-${sourceTag.replaceFirst('^DEV-', '')}"

                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.DB_REPOSITORY}:${targetTag}"

                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET IMAGE = ${targetImage}"

                    sh """
                        set -e

                        echo "Logging in to ECR..."

                        aws ecr get-login-password \
                            --region ${env.AWS_REGION} | \
                        docker login \
                            --username AWS \
                            --password-stdin ${env.ECR_REGISTRY}

                        echo "Pulling DEV image..."

                        docker pull ${sourceImage}

                        echo "Tagging image for PROD..."

                        docker tag \
                            ${sourceImage} \
                            ${targetImage}

                        echo "Pushing PROD image..."

                        docker push ${targetImage}
                    """

                    env.IMAGE_URI = targetImage

                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }

        stage('Create Task Definition') {

            steps {

                script {

                    if (!env.IMAGE_URI?.trim()) {
                        error("IMAGE_URI is empty.")
                    }

                    echo "IMAGE URI = ${env.IMAGE_URI}"
                    echo "ENVIRONMENT = ${params.ENVIRONMENT}"

                    sh """
                        set -e

                        ENVIRONMENT="${params.ENVIRONMENT}" \
                        IMAGE_URI="${env.IMAGE_URI}" \
                        TASK_DEFINITION_TEMPLATE="${env.TASK_DEFINITION_TEMPLATE}" \
                        python3 - <<'PY'

import json
import os

input_file = os.environ["TASK_DEFINITION_TEMPLATE"]
output_file = "new-db-task-definition.json"

environment = os.environ["ENVIRONMENT"]
image_uri = os.environ["IMAGE_URI"]

with open(input_file, "r") as f:
    task_definition = json.load(f)

task_definition["family"] = \
    f"employee-managemet-{environment}-db"

for container in task_definition["containerDefinitions"]:

    if container["name"] == "db":
        container["image"] = image_uri
        break

else:
    raise Exception("Container named 'db' was not found.")

with open(output_file, "w") as f:
    json.dump(task_definition, f, indent=2)

PY

                        echo "Generated task definition:"
                        cat new-db-task-definition.json
                    """
                }
            }
        }

        stage('Register and Update ECS Service') {

            steps {

                script {

                    def revision = sh(
                        script: """
                            set -e

                            aws ecs register-task-definition \
                                --cli-input-json file://new-db-task-definition.json \
                                --region ${env.AWS_REGION} \
                                --query 'taskDefinition.revision' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    echo "AWS REGISTERED REVISION = '${revision}'"

                    if (!revision ||
                        revision == 'null' ||
                        revision == 'None') {

                        error(
                            "ECS returned invalid revision: '${revision}'"
                        )
                    }

                    def environment =
                        params.ENVIRONMENT

                    def cluster =
                        "app-4-${environment}-cluster"

                    def service =
                        "app-4-${environment}-db-service"

                    def taskFamily =
                        "app-4-${environment}-db"

                    echo "ENVIRONMENT = ${environment}"
                    echo "CLUSTER = ${cluster}"
                    echo "SERVICE = ${service}"
                    echo "TASK FAMILY = ${taskFamily}"
                    echo "TASK REVISION = ${revision}"

                    sh """
                        set -e

                        aws ecs update-service \
                            --cluster ${cluster} \
                            --service ${service} \
                            --task-definition ${taskFamily}:${revision} \
                            --force-new-deployment \
                            --region ${env.AWS_REGION}

                        aws ecs wait services-stable \
                            --cluster ${cluster} \
                            --services ${service} \
                            --region ${env.AWS_REGION}
                    """

                    echo "ECS ${environment} deployment completed successfully."
                }
            }
        }
    }
}

