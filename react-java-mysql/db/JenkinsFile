
pipeline {

    agent any

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        AWS_CRED = 'AWS'

        ECR_REGISTRY ="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        DEV_REPO  = 'app-3-dev-db'
        // QA_REPO   = 'app-3-qa-db'
        // UAT_REPO  = 'app-3-uat-db'
        // PROD_REPO = 'app-3-prod-db'

        BUILD_CONTEXT ='./react-java-mysql/db'


        TASK_DEFINITION_TEMPLATE ='./react-java-mysql/db/task-definition.json'
    }


    stages {

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID =
                        sh(
                            script: 'git rev-parse --short=7 HEAD',
                            returnStdout: true
                        ).trim()

                    echo "======================================"
                    echo "COMMIT ID = ${env.COMMIT_ID}"
                    echo "======================================"
                }
            }
        }

        stage('DEV - Build Image') {

            steps {

                script {

                    /*
                     * Example:
                     *
                     * DEV-def5678-25
                     */

                    def imageTag ="DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"

                    env.DEV_IMAGE_TAG =imageTag

                    def imageUri ="${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"
                    env.DEV_IMAGE_URI =imageUri


                    echo "======================================"
                    echo "BUILD ENVIRONMENT = DEV"
                    echo "COMMIT ID         = ${env.COMMIT_ID}"
                    echo "IMAGE TAG         = ${imageTag}"
                    echo "DEV REPOSITORY    = ${env.DEV_REPO}"
                    echo "IMAGE URI         = ${imageUri}"
                    echo "======================================"


                    echo "Building APP-3 DB Docker image..."


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }


                    echo "APP-3 DB Docker image built successfully."
                }
            }
        }

        stage('DEV - Push Image') {

            steps {

                script {

                    if (!env.DEV_IMAGE_URI?.trim()) {

                        error(
                            "DEV_IMAGE_URI is empty. " +
                            "DEV image was not built successfully."
                        )
                    }


                    echo "======================================"
                    echo "PUSHING APP-3 DB IMAGE"
                    echo "DEV REPOSITORY = ${env.DEV_REPO}"
                    echo "IMAGE URI       = ${env.DEV_IMAGE_URI}"
                    echo "======================================"


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(
                            env.DEV_IMAGE_URI
                        ).push()
                    }


                    echo "APP-3 DB DEV image pushed successfully."
                }
            }
        }

        stage('Deploy DB - DEV') {

            steps {

                script {

                    deployDB(
                        'dev',
                        env.DEV_REPO,
                        env.DEV_IMAGE_TAG
                    )
                }
            }
        }

