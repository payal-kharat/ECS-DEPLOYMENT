def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage =
        "${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"


    def targetTag =
        "${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"


    def targetImage =
        "${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"


    echo "============================================================"
    echo "PROMOTING APP-3 DB IMAGE"
    echo "============================================================"
    echo "SOURCE REPOSITORY : ${sourceRepo}"
    echo "SOURCE IMAGE      : ${sourceImage}"
    echo "TARGET REPOSITORY : ${targetRepo}"
    echo "TARGET IMAGE      : ${targetImage}"
    echo "============================================================"


    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"

            aws sts get-caller-identity


            echo "Logging in to ECR..."

            aws ecr get-login-password \
                --region ${env.AWS_REGION} \
                | docker login \
                    --username AWS \
                    --password-stdin ${env.ECR_REGISTRY}


            echo "Pulling DEV image..."

            docker pull ${sourceImage}


            echo "Tagging image..."

            docker tag \
                ${sourceImage} \
                ${targetImage}


            echo "Pushing promoted image..."

            docker push ${targetImage}


            echo "============================================================"
            echo "PROMOTION COMPLETED"
            echo "TARGET IMAGE: ${targetImage}"
            echo "============================================================"
        """
    }
}

def deployDB(
    String environment,
    String repository,
    String imageTag
) {

    def imageUri ="${env.ECR_REGISTRY}/${repository}:${imageTag}"

    def taskDefinitionFile ="new-db-task-definition-${environment}.json"

    echo "============================================================"
    echo "DEPLOYING APP-3 DB"
    echo "============================================================"
    echo "Environment : ${environment}"
    echo "Repository  : ${repository}"
    echo "Image Tag   : ${imageTag}"
    echo "Image URI   : ${imageUri}"
    echo "============================================================"


    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"

            aws sts get-caller-identity
            echo "Creating ECS task definition for ${environment}..."
            ENVIRONMENT="${environment}" \
            IMAGE_URI="${imageUri}" \
            TASK_DEFINITION_TEMPLATE="${env.TASK_DEFINITION_TEMPLATE}" \
            OUTPUT_FILE="${taskDefinitionFile}" \
            python3 - <<'PYTHON'

import json
import os


input_file = os.environ["TASK_DEFINITION_TEMPLATE"]
output_file = os.environ["OUTPUT_FILE"]
environment = os.environ["ENVIRONMENT"]
image_uri = os.environ["IMAGE_URI"]


# Read original task definition

with open(input_file, "r") as f:

    task_definition = json.load(f)


# Set environment-specific family

task_definition["family"] = \
    f"app-3-{environment}-db"


# Update DB container image

container_found = False

for container in task_definition["containerDefinitions"]:

    if container["name"] == "db":

        container["image"] = image_uri

        container_found = True

        break


if not container_found:

    raise Exception(
        "Container named 'db' was not found."
    )

# Remove AWS-generated fields

remove_fields = [
    "taskDefinitionArn",
    "revision",
    "status",
    "requiresAttributes",
    "compatibilities",
    "registeredAt",
    "registeredBy"
]


for field in remove_fields:

    task_definition.pop(
        field,
        None
    )


# Write new task definition

with open(output_file, "w") as f:
    json.dump(
        task_definition,
        f,
        indent=2
    )


print("Task definition created:")
print(output_file)

print("DB image:")
print(image_uri)

PYTHON


            echo "Generated task definition:"

            cat ${taskDefinitionFile}
            echo "Registering ECS task definition..."
            REVISION=\$(aws ecs register-task-definition \
                --cli-input-json file://${taskDefinitionFile} \
                --region ${env.AWS_REGION} \
                --query 'taskDefinition.revision' \
                --output text)


            echo "AWS REGISTERED REVISION = \$REVISION"


            if [ -z "\$REVISION" ] || \
               [ "\$REVISION" = "null" ] || \
               [ "\$REVISION" = "None" ]; then

                echo "ERROR: ECS returned invalid revision."

                exit 1

            fi


            echo "Updating ECS DB service..."


            aws ecs update-service \
                --cluster app-3-${environment}-cluster \
                --service app-3-${environment}-db-service \
                --task-definition app-3-${environment}-db:\$REVISION \
                --force-new-deployment \
                --region ${env.AWS_REGION}


            echo "Waiting for ECS DB service to become stable..."


            aws ecs wait services-stable \
                --cluster app-3-${environment}-cluster \
                --services app-3-${environment}-db-service \
                --region ${env.AWS_REGION}


            echo "============================================================"
            echo "APP-3 DB ${environment} deployment completed."
            echo "Image: ${imageUri}"
            echo "============================================================"
        """
    }
}
}

