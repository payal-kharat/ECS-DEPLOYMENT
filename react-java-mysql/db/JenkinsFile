    post {

        always {

            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }


        success {

            echo '''
============================================================
APP-3 DB ECS CI/CD completed successfully.

DEV  → QA → UAT → PROD
============================================================
'''
        }


