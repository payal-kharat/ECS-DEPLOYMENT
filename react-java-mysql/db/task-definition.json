{
  "containerDefinitions": [
    {
      "name": "db",
      "image": "552940445807.dkr.ecr.us-east-1.amazonaws.com/app-3-db-dev:DEV-9325da8-1",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3306,
          "hostPort": 3306,
          "protocol": "tcp",
          "name": "mysql"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "MYSQL_DATABASE",
          "value": "example"
        },
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "value": "rootpassword"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/app-3-prod-db",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "app-3-dev-db",
  "taskRoleArn": "arn:aws:iam::552940445807:role/app-3-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::552940445807:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
