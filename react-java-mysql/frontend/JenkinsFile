
pipeline {

    agent any

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'
        AWS_CRED       = 'AWS'
        ECR_REGISTRY ="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        DEV_REPO  = 'app-3-dev-frontend'
        QA_REPO   = 'app-3-frontend-qa'
    //  UAT_REPO  = 'app-3-frontend-uat'
    //  PROD_REPO = 'app-3-frontend-prod'
        BUILD_CONTEXT ='./react-java-mysql/frontend'
        TASK_DEFINITION_TEMPLATE ='./react-java-mysql/frontend/task-definition.json'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.COMMIT_ID = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()
                    echo "======================================"
                    echo "COMMIT ID    = ${env.COMMIT_ID}"
                    echo "BUILD NUMBER = ${env.BUILD_NUMBER}"
                    echo "======================================"
                }
            }
        }

        stage('DEV - Build Frontend Image') {
            steps {
                script {
                    def imageTag ="DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"
                    def imageUri ="${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"
                    echo "======================================"
                    echo "BUILDING FRONTEND IMAGE"
                    echo "ENVIRONMENT  = DEV"
                    echo "COMMIT ID    = ${env.COMMIT_ID}"
                    echo "BUILD NUMBER = ${env.BUILD_NUMBER}"
                    echo "IMAGE TAG    = ${imageTag}"
                    echo "IMAGE URI    = ${imageUri}"
                    echo "======================================"
                    env.DEV_IMAGE_TAG = imageTag
                    env.IMAGE_URI = imageUri
                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {
                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }

                    echo "Frontend DEV image built successfully."
                }
            }
        }

        stage('DEV - Push Frontend Image') {
            steps {
                script {
                  if (!env.IMAGE_URI?.trim()) {
                        error(
                            "IMAGE_URI is empty. " +
                            "DEV build must complete first."
                        )
                    }

                    echo "Pushing DEV frontend image..."
                    echo "IMAGE URI = ${env.IMAGE_URI}"
                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {
                        docker.image(env.IMAGE_URI).push()
                    }

                    echo "DEV frontend image pushed successfully."
                }
            }
        }

        // stage('Deploy Frontend - DEV') {
        //     steps {
        //         script {
        //             deployFrontend(
        //                 'dev',
        //                 env.DEV_REPO,
        //                 env.DEV_IMAGE_TAG
        //             )
        //         }
        //     }
        // }

        stage('Promote Frontend - DEV to QA') {
            steps {
                script {
                    env.QA_IMAGE_TAG = promoteImage(
                        env.DEV_REPO,
                        env.QA_REPO,
                        env.DEV_IMAGE_TAG,
                        'QA'
                    )
                    env.IMAGE_URI ="${env.ECR_REGISTRY}/${env.QA_REPO}:${env.QA_IMAGE_TAG}"
                    echo "QA IMAGE URI = ${env.IMAGE_URI}"
                }
            }
        }

        stage('Deploy Frontend - QA') {
            steps {
                script {
                    deployFrontend(
                        'qa',
                        env.QA_REPO,
                        env.QA_IMAGE_TAG
                    )
                }
            }
        }

        // stage('Promote Frontend - DEV to UAT') {
        //     steps {
        //         script {
        //             env.UAT_IMAGE_TAG = promoteImage(
        //                 env.DEV_REPO,
        //                 env.UAT_REPO,
        //                 env.DEV_IMAGE_TAG,
        //                 'UAT'
        //             )

        //             env.IMAGE_URI ="${env.ECR_REGISTRY}/${env.UAT_REPO}:${env.UAT_IMAGE_TAG}"
        //             echo "UAT IMAGE URI = ${env.IMAGE_URI}"
        //         }
        //     }
        // }

        // stage('Deploy Frontend - UAT') {
        //     steps {
        //         script {
        //             deployFrontend(
        //                 'uat',
        //                 env.UAT_REPO,
        //                 env.UAT_IMAGE_TAG
        //             )
        //         }
        //     }
        // }

        // stage('Production Approval') {
        //     steps {
        //         input(
        //             message: 'UAT deployment completed. Deploy Frontend to PROD?',
        //             ok: 'Deploy to PROD'
        //         )
        //     }
        // }

        // stage('Promote Frontend - DEV to PROD') {
        //     steps {
        //         script {
        //             env.PROD_IMAGE_TAG = promoteImage(
        //                 env.DEV_REPO,
        //                 env.PROD_REPO,
        //                 env.DEV_IMAGE_TAG,
        //                 'PROD'
        //             )
        //             env.IMAGE_URI ="${env.ECR_REGISTRY}/${env.PROD_REPO}:${env.PROD_IMAGE_TAG}"
        //             echo "PROD IMAGE URI = ${env.IMAGE_URI}"
        //         }
        //     }
        // }

        // stage('Deploy Frontend - PROD') {
        //     steps {
        //         script {
        //             deployFrontend(
        //                 'prod',
        //                 env.PROD_REPO,
        //                 env.PROD_IMAGE_TAG
        //             )
        //         }
        //     }
        // }
    }

    post {

        success {

            echo "======================================"
            echo "APP-3 FRONTEND PIPELINE SUCCESS"
            echo "DEV TAG  = ${env.DEV_IMAGE_TAG}"
            echo "QA TAG   = ${env.QA_IMAGE_TAG}"
            echo "UAT TAG  = ${env.UAT_IMAGE_TAG}"
            echo "PROD TAG = ${env.PROD_IMAGE_TAG}"
            echo "======================================"
        }

        failure {
            echo "======================================"
            echo "APP-3 FRONTEND PIPELINE FAILED"
            echo "======================================"
        }

        always {
            cleanWs()
        }
    }
}


def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage ="${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"
    def targetTag ="${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"
    def targetImage ="${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"

    echo "======================================"
    echo "IMAGE PROMOTION"
    echo "SOURCE REPO  = ${sourceRepo}"
    echo "SOURCE TAG   = ${sourceTag}"
    echo "SOURCE IMAGE = ${sourceImage}"
    echo "TARGET REPO  = ${targetRepo}"
    echo "TARGET TAG   = ${targetTag}"
    echo "TARGET IMAGE = ${targetImage}"
    echo "======================================"

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'AWS'
        ]
    ]) {
        sh """
            set -e
            echo "AWS identity:"
            aws sts get-caller-identity \
                --region ${env.AWS_REGION}
            echo "Logging in to ECR..."
            aws ecr get-login-password \
                --region ${env.AWS_REGION} | \
            docker login \
                --username AWS \
                --password-stdin ${env.ECR_REGISTRY}

            echo "Pulling DEV frontend image..."
            docker pull ${sourceImage}
            echo "Tagging image for ${targetEnvironment}..."

            docker tag \
                ${sourceImage} \
                ${targetImage}
            echo "Pushing promoted frontend image..."
            docker push ${targetImage}
            echo "Image promotion completed."
        """
    }

    return targetTag
}


def deployFrontend(
    String environment,
    String repository,
    String imageTag
) {

    def imageUri ="${env.ECR_REGISTRY}/${repository}:${imageTag}"
    def cluster ="app-3-${environment}-cluster"
    def service ="app-3-${environment}-frontend-service"
    def taskFamily ="app-3-${environment}-frontend"
    def taskDefinitionFile ="new-frontend-task-definition-${environment}.json"

    echo "======================================"
    echo "ECS FRONTEND DEPLOYMENT"
    echo "ENVIRONMENT  = ${environment}"
    echo "REPOSITORY   = ${repository}"
    echo "IMAGE TAG    = ${imageTag}"
    echo "IMAGE URI    = ${imageUri}"
    echo "CLUSTER      = ${cluster}"
    echo "SERVICE      = ${service}"
    echo "TASK FAMILY  = ${taskFamily}"
    echo "TASK FILE    = ${taskDefinitionFile}"
    echo "======================================"

    if (!fileExists(env.TASK_DEFINITION_TEMPLATE)) {
        error(
            "Task definition template not found: " +
            "${env.TASK_DEFINITION_TEMPLATE}"
        )
    }

    sh """
        set -e
        cp \
            '${env.TASK_DEFINITION_TEMPLATE}' \
            '${taskDefinitionFile}'
        python3 - '${taskDefinitionFile}' '${imageUri}' '${environment}' <<'PY'
import json
import sys

filename = sys.argv[1]
image_uri = sys.argv[2]
environment = sys.argv[3]
with open(filename, "r") as f:
    data = json.load(f)
data["family"] = f"app-3-{environment}-frontend"
updated = False
for container in data.get("containerDefinitions", []):

    if container.get("name") == "frontend":
        container["image"] = image_uri
        updated = True

if not updated:
    raise Exception(
        "Container named 'frontend' was not found in the task definition."
    )

for field in [
    "taskDefinitionArn",
    "revision",
    "status",
    "requiresAttributes",
    "compatibilities",
    "registeredAt",
    "registeredBy"
]:
    data.pop(field, None)
with open(filename, "w") as f:
    json.dump(data, f, indent=2)

print("Updated frontend container image:")
print(image_uri)
PY

        echo "Generated task definition:"
        cat '${taskDefinitionFile}'
    """

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: 'AWS'
        ]
    ]) {

        echo "Checking AWS credentials..."
        sh """
            set -e
            aws sts get-caller-identity \
                --region ${env.AWS_REGION}
        """

        def revision = sh(
            script: """
                set -e
                aws ecs register-task-definition \
                    --cli-input-json file://${taskDefinitionFile} \
                    --region ${env.AWS_REGION} \
                    --query 'taskDefinition.revision' \
                    --output text
            """,
            returnStdout: true
        ).trim()

        echo "AWS REGISTERED REVISION = '${revision}'"
        if (!revision ||
            revision == 'null' ||
            revision == 'None') {
            error(
                "ECS returned invalid revision: '${revision}'"
            )
        }

        echo "Updating ECS service..."
        sh """
            set -e
            echo "Cluster     = ${cluster}"
            echo "Service     = ${service}"
            echo "Task Family = ${taskFamily}"
            echo "Revision    = ${revision}"

            aws ecs update-service \
                --cluster ${cluster} \
                --service ${service} \
                --task-definition ${taskFamily}:${revision} \
                --force-new-deployment \
                --region ${env.AWS_REGION}

            echo "Waiting for ECS service to become stable..."

            aws ecs wait services-stable \
                --cluster ${cluster} \
                --services ${service} \
                --region ${env.AWS_REGION}

            echo "ECS service is stable."
        """
    }

    echo "======================================"
    echo "APP-3 FRONTEND ${environment.toUpperCase()} DEPLOYMENT SUCCESSFUL"
    echo "IMAGE = ${imageUri}"
    echo "======================================"
}
