    post {

        success {

            echo "======================================"
            echo "APP-3 BACKEND PIPELINE SUCCESS"
            echo "DEV TAG  = ${env.DEV_IMAGE_TAG}"
            echo "QA TAG   = ${env.QA_IMAGE_TAG}"
            echo "UAT TAG  = ${env.UAT_IMAGE_TAG}"
