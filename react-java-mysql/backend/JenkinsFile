
pipeline {

    agent any

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'
        AWS_CRED       = 'AWS'

        ECR_REGISTRY ="${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        DEV_REPO  = 'app-3-dev-backend'
       // QA_REPO   = 'app-3-qa-backend'
