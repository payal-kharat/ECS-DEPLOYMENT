       // PROD_REPO = 'app-3-prod-backend'

        BUILD_CONTEXT ='./react-java-mysql/backend'

        TASK_DEFINITION_TEMPLATE ='./react-java-mysql/backend/task-definition.json'
    }

    stages {

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()

                    echo "======================================"
                    echo "COMMIT ID = ${env.COMMIT_ID}"
                    echo "BUILD NUMBER = ${env.BUILD_NUMBER}"
                    echo "======================================"
                }
            }
        }

        stage('DEV - Build Backend Image') {

            steps {

                script {

                    def imageTag =
                        "DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"

                    echo "======================================"
                    echo "BUILDING BACKEND IMAGE"
                    echo "ENVIRONMENT  = DEV"
                    echo "COMMIT ID    = ${env.COMMIT_ID}"
                    echo "BUILD NUMBER = ${env.BUILD_NUMBER}"
                    echo "IMAGE TAG    = ${imageTag}"
                    echo "IMAGE URI    = ${imageUri}"
                    echo "======================================"

                    env.DEV_IMAGE_TAG = imageTag
                    env.IMAGE_URI = imageUri

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }

                    echo "Backend DEV image built successfully."
                }
            }
        }

        stage('DEV - Push Backend Image') {

            steps {

                script {

                    if (!env.IMAGE_URI?.trim()) {

                        error(
                            "IMAGE_URI is empty. " +
                            "DEV build must complete first."
                        )
                    }

                    echo "Pushing DEV backend image..."
                    echo "IMAGE URI = ${env.IMAGE_URI}"

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(env.IMAGE_URI).push()
                    }

                    echo "DEV backend image pushed successfully."
                }
            }
        }

        stage('Deploy Backend - DEV') {

            steps {

                script {

                    deployBackend(
                        'dev',
                        env.DEV_REPO,
                        env.DEV_IMAGE_TAG
                    )
                }
            }
        }

        // stage('Promote Backend - DEV to QA') {

