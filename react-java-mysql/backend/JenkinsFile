        // echo "QA IMAGE URI = ${env.IMAGE_URI}"
        // }
        // }
        // }

        // stage('Deploy Backend - QA') {

        // steps {

        // script {

        // deployBackend(
        // 'qa',
        // env.QA_REPO,
        // env.QA_IMAGE_TAG
        // )
        // }
        // }
        // }

        // stage('Promote Backend - DEV to UAT') {

        // steps {

        // script {

        // env.UAT_IMAGE_TAG = promoteImage(
        // env.DEV_REPO,
        // env.UAT_REPO,
