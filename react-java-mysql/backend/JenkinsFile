def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage =
        "${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"

    def targetTag =
        "${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"

    def targetImage =
        "${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"

    echo "======================================"
    echo "IMAGE PROMOTION"
    echo "SOURCE REPO = ${sourceRepo}"
    echo "SOURCE TAG  = ${sourceTag}"
    echo "SOURCE IMAGE = ${sourceImage}"
    echo "TARGET REPO = ${targetRepo}"
    echo "TARGET TAG  = ${targetTag}"
    echo "TARGET IMAGE = ${targetImage}"
    echo "======================================"

    withCredentials([
        [$class: 'AmazonWebServicesCredentialsBinding',
         credentialsId:'AWS']
    ]) {

        sh """
            set -e

            echo "AWS identity:"
            aws sts get-caller-identity

            echo "Logging in to ECR..."

            aws ecr get-login-password \
                --region ${env.AWS_REGION} | \
            docker login \
                --username AWS \
                --password-stdin ${env.ECR_REGISTRY}

            echo "Pulling DEV image..."

            docker pull ${sourceImage}

            echo "Tagging image for ${targetEnvironment}..."

            docker tag \
                ${sourceImage} \
                ${targetImage}

            echo "Pushing promoted image..."

            docker push ${targetImage}

            echo "Image promotion completed."
        """
    }

    return targetTag
}

def deployBackend(
    indent=2
) {

    // your existing task-definition generation code
    // ...
    // echo "Generated task definition:"
    // cat ${taskDefinitionFile}


    withCredentials([
        [$class: 'AmazonWebServicesCredentialsBinding',
         credentialsId: 'AWS']
    ]) {

        echo "Checking AWS credentials..."

        sh """
            set -e

            aws sts get-caller-identity \
                --region ${env.AWS_REGION}
        """

        def revision = sh(
            script: """
                set -e

                aws ecs register-task-definition \
                    --cli-input-json file://${taskDefinitionFile} \
                    --region ${env.AWS_REGION} \
                    --query 'taskDefinition.revision' \
                    --output text
            """,
            returnStdout: true
        ).trim()

        echo "AWS REGISTERED REVISION = '${revision}'"

        if (!revision ||
            revision == 'null' ||
            revision == 'None') {

            error(
                "ECS returned invalid revision: '${revision}'"
            )
        }

        echo "Updating ECS service..."

        sh """
            set -e

            echo "Cluster     = ${cluster}"
            echo "Service     = ${service}"
            echo "Task Family = ${taskFamily}"
            echo "Revision    = ${revision}"

            aws ecs update-service \
                --cluster ${cluster} \
                --service ${service} \
                --task-definition ${taskFamily}:${revision} \
                --force-new-deployment \
                --region ${env.AWS_REGION}

            echo "Waiting for ECS service to become stable..."

            aws ecs wait services-stable \
                --cluster ${cluster} \
                --services ${service} \
                --region ${env.AWS_REGION}
        """
    }

    echo "======================================"
    echo "APP-3 BACKEND ${environment.toUpperCase()} DEPLOYMENT SUCCESSFUL"
    echo "IMAGE = ${imageUri}"
    echo "======================================"
}
