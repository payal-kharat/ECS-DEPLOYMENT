        // 'UAT'
        // )

        // env.IMAGE_URI =
        // "${env.ECR_REGISTRY}/${env.UAT_REPO}:${env.UAT_IMAGE_TAG}"

        // echo "UAT IMAGE URI = ${env.IMAGE_URI}"
        // }
        // }
