{
  "family": "app-4-dev-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::552940445807:role/app-4-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "552940445807.dkr.ecr.us-east-1.amazonaws.com/app-4-db:DEV-f04b4e6-7",
      "cpu": 0,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "name": "backend"
        }
      ],
      "environment": [
        {
          "name": "PG_PASSWORD",
          "value": "mysecretpassword"
        },
        {
          "name": "RUST_LOG",
          "value": "debug"
        },
        {
          "name": "PG_USER",
          "value": "postgres"
        },
        {
          "name": "ADDRESS",
          "value": "0.0.0.0:8000"
        },
        {
          "name": "PG_DBNAME",
          "value": "postgres"
        },
        {
          "name": "PG_HOST",
          "value": "app4-db"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/app-4-dev-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
