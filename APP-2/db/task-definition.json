{
  "containerDefinitions": [
    {
      "name": "db",
      "image": "mysql:latest",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 3306,
          "hostPort": 3306,
          "protocol": "tcp",
          "name": "mysql"
        }
      ],
      "essential": true,
      "environment": [
  {
    "name": "MYSQL_DATABASE",
    "value": "example"
  },
  {
    "name": "MYSQL_ROOT_PASSWORD",
    "value": "rootpassword"
  }
],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": []
    }
  ],
  "family": "app-2-dev-db",
  "executionRoleArn": "arn:aws:iam::552940445807:role/app-2-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}