pipeline {
    agent any

    environment {
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'
        ECR_REGISTRY   = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        AWS_CRED       = 'AWS'

        DEV_REPO  = 'app-1-db-dev'
        // QA_REPO   = 'app-1-db-qa'
        // UAT_REPO  = 'app-1-db-uat'
        // PROD_REPO = 'app-1-db-prod'

        BUILD_CONTEXT             = './nginx-flask-mysql/db'
        TASK_DEFINITION_TEMPLATE  = './nginx-flask-mysql/db/task-definition.json'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm

                script {
                    env.COMMIT_ID = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Commit ID: ${env.COMMIT_ID}"
                }
            }
        }

        stage('Build DB Image - DEV') {
            steps {
                script {

                    def imageTag = "DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"

                    env.DEV_IMAGE_TAG = imageTag

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"

                    echo "============================================================"
                    echo "Building DB Image - DEV"
                    echo "Image: ${imageUri}"
                    echo "============================================================"

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }
                }
            }
        }

        stage('Push DB Image - DEV') {
            steps {
                script {

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${env.DEV_IMAGE_TAG}"

                    echo "============================================================"
                    echo "Pushing DEV DB Image"
                    echo "Image: ${imageUri}"
                    echo "============================================================"

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(imageUri).push()
                    }
                }
            }
        }

        stage('Deploy DB - DEV') {
            steps {
                script {

                    deployDB(
                        'dev',
                        env.DEV_REPO,
                        env.DEV_IMAGE_TAG
                    )
                }
            }
        }

        /*
        stage('Promote DB Image - QA') {
            steps {
                script {

                    env.QA_IMAGE_TAG = promoteImage(
                        env.DEV_REPO,
                        env.QA_REPO,
                        env.DEV_IMAGE_TAG,
                        'QA'
                    )
                }
            }
        }

        stage('Deploy DB - QA') {
            steps {
                script {

                    deployDB(
                        'qa',
                        env.QA_REPO,
                        env.QA_IMAGE_TAG
                    )
                }
            }
        }
        */

        /*
        stage('Promote DB Image - UAT') {
            steps {
                script {

                    env.UAT_IMAGE_TAG = promoteImage(
                        env.QA_REPO,
                        env.UAT_REPO,
                        env.QA_IMAGE_TAG,
                        'UAT'
                    )
                }
            }
        }

        stage('Deploy DB - UAT') {
            steps {
                script {

                    deployDB(
                        'uat',
                        env.UAT_REPO,
                        env.UAT_IMAGE_TAG
                    )
                }
            }
        }
        */
       /*
        stage('Promote DB Image - PROD') {
            steps {
                script {

                    env.PROD_IMAGE_TAG = promoteImage(
                        env.UAT_REPO,
                        env.PROD_REPO,
                        env.UAT_IMAGE_TAG,
                        'PROD'
                    )
                }
            }
        }

        stage('Deploy DB - PROD') {
            steps {
                script {

                    deployDB(
                        'prod',
                        env.PROD_REPO,
                        env.PROD_IMAGE_TAG
                    )
                }
            }
        }
        */

    }   

    post {

        success {
            echo "============================================================"
            echo "DB PIPELINE COMPLETED SUCCESSFULLY"
            echo "============================================================"
        }

        failure {
            echo "============================================================"
            echo "DB PIPELINE FAILED"
            echo "============================================================"
        }

        always {
            echo "DB pipeline execution finished."
        }
    }
}


// ====================================================================
// FUNCTION: promoteImage
// ====================================================================

def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage =
        "${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"

    def targetTag =
        "${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"

    def targetImage =
        "${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"

    echo "============================================================"
    echo "Promoting Image"
    echo "Source Image : ${sourceImage}"
    echo "Target Image : ${targetImage}"
    echo "============================================================"

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "Checking AWS identity..."
            aws sts get-caller-identity

            echo "Logging in to ECR..."

            aws ecr get-login-password \
                --region ${env.AWS_REGION} \
                | docker login \
                    --username AWS \
                    --password-stdin ${env.ECR_REGISTRY}

            echo "Pulling source image..."
            docker pull ${sourceImage}

            echo "Tagging image..."
            docker tag ${sourceImage} ${targetImage}

            echo "Pushing target image..."
            docker push ${targetImage}

            echo "Image promotion completed."
            echo "Target image: ${targetImage}"
        """
    }

    return targetTag
}


// ====================================================================
// FUNCTION: deployDB
// ====================================================================

def deployDB(
    String environment,
    String repository,
    String imageTag
) {

    def imageUri =
        "${env.ECR_REGISTRY}/${repository}:${imageTag}"

    def taskDefinitionFile =
        "new-db-task-definition-${environment}.json"

    echo "============================================================"
    echo "Deploying DB"
    echo "Environment : ${environment}"
    echo "Repository  : ${repository}"
    echo "Image Tag   : ${imageTag}"
    echo "Image URI   : ${imageUri}"
    echo "============================================================"

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "Checking AWS identity..."
            aws sts get-caller-identity

            echo "Creating DB task definition for ${environment}..."

            python3 - <<PYTHON

import json

# ------------------------------------------------------------
# Read existing task definition template
# ------------------------------------------------------------

with open("${env.TASK_DEFINITION_TEMPLATE}") as f:
    task_definition = json.load(f)


# ------------------------------------------------------------
# Set environment-specific task definition family
# ------------------------------------------------------------

task_definition["family"] = "app-1-${environment}-db"


# ------------------------------------------------------------
# Update DB container image
# ------------------------------------------------------------

for container in task_definition["containerDefinitions"]:

    if container["name"] == "db":

        container["image"] = "${imageUri}"


# ------------------------------------------------------------
# Remove AWS-generated/read-only fields
# ------------------------------------------------------------

remove_fields = [
    "taskDefinitionArn",
    "revision",
    "status",
    "requiresAttributes",
    "compatibilities",
    "registeredAt",
    "registeredBy"
]

for field in remove_fields:

    task_definition.pop(
        field,
        None
    )


# ------------------------------------------------------------
# Save new task definition
# ------------------------------------------------------------

with open("${taskDefinitionFile}", "w") as f:

    json.dump(
        task_definition,
        f,
        indent=2
    )


print("Task definition created:")
print("${taskDefinitionFile}")

print("DB Image:")
print("${imageUri}")

PYTHON


            # --------------------------------------------------------
            # Register ECS task definition
            # --------------------------------------------------------

            echo "Registering ECS DB task definition..."

            REVISION=\\$(aws ecs register-task-definition \
                --cli-input-json file://${taskDefinitionFile} \
                --region ${env.AWS_REGION} \
                --query 'taskDefinition.revision' \
                --output text)

            echo "Registered revision: \\$REVISION"


            # --------------------------------------------------------
            # Update ECS DB service
            # --------------------------------------------------------

            echo "Updating ECS DB service..."

            aws ecs update-service \
                --cluster app-1-${environment}-cluster \
                --service app-1-${environment}-db-service \
                --task-definition app-1-${environment}-db:\\$REVISION \
                --force-new-deployment \
                --region ${env.AWS_REGION}


            # --------------------------------------------------------
            # Wait for ECS service
            # --------------------------------------------------------

            echo "Waiting for ECS DB service to become stable..."

            aws ecs wait services-stable \
                --cluster app-1-${environment}-cluster \
                --services app-1-${environment}-db-service \
                --region ${env.AWS_REGION}


            echo "============================================================"
            echo "DB deployment completed successfully."
            echo "Environment : ${environment}"
            echo "Task Definition : app-1-${environment}-db:\\$REVISION"
            echo "Image : ${imageUri}"
            echo "============================================================"

        """
    }
}
