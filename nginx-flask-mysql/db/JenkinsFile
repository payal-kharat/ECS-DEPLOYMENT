
pipeline {

    agent any

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        AWS_CRED = 'AWS'

        // ============================================================
        // ECR REPOSITORIES
        // ============================================================

        DEV_REPO  = 'app-1-db-dev'
        QA_REPO   = 'app-1-db-qa'
        UAT_REPO  = 'app-1-db-uat'
        PROD_REPO = 'app-1-db-prod'

        // ============================================================
        // DOCKER BUILD LOCATION
        // ============================================================

        BUILD_CONTEXT =
            './nginx-flask-mysql/db'

        // ============================================================
        // ECS TASK DEFINITION TEMPLATE
        // ============================================================

        TASK_DEFINITION_TEMPLATE =
            './nginx-flask-mysql/db/task-definition.json'
    }


    stages {

        // ============================================================
        // 1. CHECKOUT
        // ============================================================

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID =
                        sh(
                            script: 'git rev-parse --short HEAD',
                            returnStdout: true
                        ).trim()

                    echo "Commit ID: ${env.COMMIT_ID}"
                }
            }
        }


        // ============================================================
        // 2. BUILD DB IMAGE ONLY IN DEV
        // ============================================================

        stage('Build DB Image - DEV') {

            steps {

                script {

                    def imageTag =
                        "DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"

                    env.DEV_IMAGE_TAG = imageTag

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"

                    echo "============================================================"
                    echo "Building DB Image"
                    echo "Image: ${imageUri}"
                    echo "============================================================"

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }
                }
            }
        }


        // ============================================================
        // 3. PUSH DB IMAGE - DEV
        // ============================================================

        stage('Push DB Image - DEV') {

            steps {

                script {

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${env.DEV_IMAGE_TAG}"

                    echo "============================================================"
                    echo "Pushing DEV DB Image"
                    echo "Image: ${imageUri}"
                    echo "============================================================"

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(imageUri).push()
                    }
                }
            }
        }


        // ============================================================
        // 4. DEPLOY DB - DEV
        // ============================================================

        stage('Deploy DB - DEV') {

            steps {

                script {

                    deployDB(
                        'dev',
                        env.DEV_REPO,
                        env.DEV_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 5. PROMOTE DEV → QA
        // ============================================================

        stage('Promote DB - DEV to QA') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.QA_REPO,
                        env.DEV_IMAGE_TAG,
                        'QA'
                    )

                    env.QA_IMAGE_TAG =
                        "QA-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }


        // ============================================================
        // 6. DEPLOY DB - QA
        // ============================================================

        stage('Deploy DB - QA') {

            steps {

                script {

                    deployDB(
                        'qa',
                        env.QA_REPO,
                        env.QA_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 7. PROMOTE DEV → UAT
        // ============================================================

        stage('Promote DB - DEV to UAT') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.UAT_REPO,
                        env.DEV_IMAGE_TAG,
                        'UAT'
                    )

                    env.UAT_IMAGE_TAG =
                        "UAT-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }


        // ============================================================
        // 8. DEPLOY DB - UAT
        // ============================================================

        stage('Deploy DB - UAT') {

            steps {

                script {

                    deployDB(
                        'uat',
                        env.UAT_REPO,
                        env.UAT_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 9. MANUAL PRODUCTION APPROVAL
        // ============================================================

        stage('Production Approval') {

            steps {

                input(
                    message: 'DEV, QA and UAT DB deployment completed. Deploy DB to PROD?',
                    ok: 'Deploy to PROD'
                )
            }
        }


        // ============================================================
        // 10. PROMOTE DEV → PROD
        // ============================================================

        stage('Promote DB - DEV to PROD') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.PROD_REPO,
                        env.DEV_IMAGE_TAG,
                        'PROD'
                    )

                    env.PROD_IMAGE_TAG =
                        "PROD-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }


        // ============================================================
        // 11. DEPLOY DB - PROD
        // ============================================================

        stage('Deploy DB - PROD') {

            steps {

                script {

                    deployDB(
                        'prod',
                        env.PROD_REPO,
                        env.PROD_IMAGE_TAG
                    )
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }

        success {

            echo '''
============================================================
DB ECS CI/CD completed successfully.

DEV  → QA → UAT → PROD

DB image was built only once in DEV.
The same image was promoted to QA, UAT and PROD.
============================================================
'''
        }

        failure {

            echo '''
============================================================
DB ECS CI/CD FAILED.

Check the Jenkins console output.
============================================================
'''
        }
    }
}


// ====================================================================
// FUNCTION: PROMOTE IMAGE
// ====================================================================

def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage =
        "${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"

    def targetTag =
        "${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"

    def targetImage =
        "${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"


    echo "============================================================"
    echo "Promoting DB image"
    echo "SOURCE : ${sourceImage}"
    echo "TARGET : ${targetImage}"
    echo "============================================================"


    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"

            aws sts get-caller-identity


            echo "Logging into ECR..."

            aws ecr get-login-password \
                --region ${env.AWS_REGION} \
                | docker login \
                    --username AWS \
                    --password-stdin ${env.ECR_REGISTRY}


            echo "Pulling DEV DB image..."

            docker pull ${sourceImage}


            echo "Retagging DB image..."

            docker tag \
                ${sourceImage} \
                ${targetImage}


            echo "Pushing promoted DB image..."

            docker push ${targetImage}


            echo "Promotion completed:"

            echo "${targetImage}"
        """
    }
}


// ====================================================================
// FUNCTION: DEPLOY DB TO ECS
// ====================================================================

def deployDB(
    String environment,
    String repository,
    String imageTag
) {

    def imageUri =
        "${env.ECR_REGISTRY}/${repository}:${imageTag}"

    def taskDefinitionFile =
        "new-db-task-definition-${environment}.json"


    echo "============================================================"
    echo "Deploying DB"
    echo "Environment : ${environment}"
    echo "Image       : ${imageUri}"
    echo "============================================================"


    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"

            aws sts get-caller-identity


            echo "Creating DB task definition for ${environment}..."


            python3 - <<PYTHON

import json


with open("${env.TASK_DEFINITION_TEMPLATE}") as f:

    task_definition = json.load(f)


# Set environment-specific task definition family

task_definition["family"] = \
    "app-1-${environment}-db"


# Update DB container image

for container in task_definition["containerDefinitions"]:

    if container["name"] == "db":

        container["image"] = \
            "${imageUri}"


# Remove fields returned by
# describe-task-definition which cannot
# be passed back during registration.

remove_fields = [

    "taskDefinitionArn",

    "revision",

    "status",

    "requiresAttributes",

    "compatibilities",

    "registeredAt",

    "registeredBy"
]


for field in remove_fields:

    task_definition.pop(
        field,
        None
    )


# Save new task definition

with open("${taskDefinitionFile}", "w") as f:

    json.dump(
        task_definition,
        f,
        indent=2
    )


print("Task definition created:")

print("${taskDefinitionFile}")


print("DB Image:")

print("${imageUri}")

PYTHON


            echo "Registering ECS DB task definition..."


            REVISION=\$(aws ecs register-task-definition \
                --cli-input-json file://${taskDefinitionFile} \
                --region ${env.AWS_REGION} \
                --query 'taskDefinition.revision' \
                --output text)


            echo "Registered revision: \$REVISION"


            echo "Updating ECS DB service..."


            aws ecs update-service \
                --cluster app-1-${environment}-cluster \
                --service app-1-${environment}-db-service \
                --task-definition app-1-${environment}-db:\$REVISION \
                --force-new-deployment \
                --region ${env.AWS_REGION}


            echo "Waiting for ECS DB service to become stable..."


            aws ecs wait services-stable \
                --cluster app-1-${environment}-cluster \
                --services app-1-${environment}-db-service \
                --region ${env.AWS_REGION}


            echo "============================================================"
            echo "DB ${environment} deployment completed."
            echo "Image: ${imageUri}"
            echo "============================================================"
        """
    }
}

