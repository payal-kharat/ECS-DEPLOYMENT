
pipeline {

    agent any

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        AWS_CRED = 'AWS'

        // ECR repositories
        DEV_REPO  = 'app-1-backend-dev'
        QA_REPO   = 'app-1-backend-qa'
        UAT_REPO  = 'app-1-backend-uat'
        PROD_REPO = 'app-1-backend-prod'

        // Docker build location
        BUILD_CONTEXT =
            './nginx-flask-mysql/backend'

        // ECS task definition template
        TASK_DEFINITION_TEMPLATE =
            './nginx-flask-mysql/backend/task-definition.json'
    }

    stages {

        // ============================================================
        // 1. CHECKOUT
        // ============================================================

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID =
                        sh(
                            script: 'git rev-parse --short HEAD',
                            returnStdout: true
                        ).trim()

                    echo "Commit ID: ${env.COMMIT_ID}"
                }
            }
        }


        // ============================================================
        // 2. BUILD BACKEND IMAGE ONLY IN DEV
        // ============================================================

        stage('Build Backend Image - DEV') {

            steps {

                script {

                    def imageTag =
                        "DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"

                    env.DEV_IMAGE_TAG = imageTag

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"

                    echo "Building Backend Image:"
                    echo "${imageUri}"

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }
                }
            }
        }


        // ============================================================
        // 3. PUSH DEV IMAGE
        // ============================================================

        stage('Push Backend Image - DEV') {

            steps {

                script {

                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${env.DEV_IMAGE_TAG}"

                    echo "Pushing DEV image:"
                    echo "${imageUri}"

                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(imageUri).push()
                    }
                }
            }
        }


        // ============================================================
        // 4. DEPLOY DEV
        // ============================================================

        stage('Deploy Backend - DEV') {

            steps {

                script {

                    deployBackend(
                        'dev',
                        env.DEV_REPO,
                        env.DEV_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 5. PROMOTE DEV → QA
        // ============================================================

        stage('Promote Backend - DEV to QA') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.QA_REPO,
                        env.DEV_IMAGE_TAG,
                        'QA'
                    )

                    env.QA_IMAGE_TAG =
                        "QA-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }


        // ============================================================
        // 6. DEPLOY QA
        // ============================================================

        stage('Deploy Backend - QA') {

            steps {

                script {

                    deployBackend(
                        'qa',
                        env.QA_REPO,
                        env.QA_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 7. PROMOTE DEV → UAT
        // ============================================================

        stage('Promote Backend - DEV to UAT') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.UAT_REPO,
                        env.DEV_IMAGE_TAG,
                        'UAT'
                    )

                    env.UAT_IMAGE_TAG =
                        "UAT-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }


        // ============================================================
        // 8. DEPLOY UAT
        // ============================================================

        stage('Deploy Backend - UAT') {

            steps {

                script {

                    deployBackend(
                        'uat',
                        env.UAT_REPO,
                        env.UAT_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 9. MANUAL APPROVAL
        // ============================================================

        stage('Production Approval') {

            steps {

                input(
                    message: 'DEV, QA and UAT deployment completed. Deploy Backend to PROD?',
                    ok: 'Deploy to PROD'
                )
            }
        }


        // ============================================================
        // 10. PROMOTE DEV → PROD
        // ============================================================

        stage('Promote Backend - DEV to PROD') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.PROD_REPO,
                        env.DEV_IMAGE_TAG,
                        'PROD'
                    )

                    env.PROD_IMAGE_TAG =
                        "PROD-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"
                }
            }
        }


        // ============================================================
        // 11. DEPLOY PROD
        // ============================================================

        stage('Deploy Backend - PROD') {

            steps {

                script {

                    deployBackend(
                        'prod',
                        env.PROD_REPO,
                        env.PROD_IMAGE_TAG
                    )
                }
            }
        }
    }


    // ================================================================
    // POST
    // ================================================================

    post {

        always {

            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }

        success {

            echo '''
============================================================
Backend ECS CI/CD completed successfully.

DEV  → QA → UAT → PROD

Image was built only once in DEV.
The same image was promoted to QA, UAT and PROD.
============================================================
'''
        }

        failure {

            echo '''
============================================================
Backend ECS CI/CD FAILED.
Check the Jenkins console output.
============================================================
'''
        }
    }
}


// ====================================================================
// FUNCTION: PROMOTE IMAGE
// ====================================================================

def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage =
        "${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"

    def targetTag =
        "${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"

    def targetImage =
        "${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"

    echo "============================================================"
    echo "Promoting image"
    echo "SOURCE : ${sourceImage}"
    echo "TARGET : ${targetImage}"
    echo "============================================================"

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"
            aws sts get-caller-identity

            echo "Logging into ECR..."

            aws ecr get-login-password \
                --region ${env.AWS_REGION} \
                | docker login \
                    --username AWS \
                    --password-stdin ${env.ECR_REGISTRY}

            echo "Pulling DEV image..."

            docker pull ${sourceImage}

            echo "Retagging image..."

            docker tag \
                ${sourceImage} \
                ${targetImage}

            echo "Pushing promoted image..."

            docker push ${targetImage}

            echo "Promotion completed:"
            echo "${targetImage}"
        """
    }
}


// ====================================================================
// FUNCTION: DEPLOY BACKEND TO ECS
// ====================================================================

def deployBackend(
    String environment,
    String repository,
    String imageTag
) {

    def imageUri =
        "${env.ECR_REGISTRY}/${repository}:${imageTag}"

    def taskDefinitionFile =
        "new-backend-task-definition-${environment}.json"

    echo "============================================================"
    echo "Deploying Backend"
    echo "Environment : ${environment}"
    echo "Image       : ${imageUri}"
    echo "============================================================"

    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"
            aws sts get-caller-identity

            echo "Creating task definition for ${environment}..."

            python3 - <<PYTHON
import json

with open("${env.TASK_DEFINITION_TEMPLATE}") as f:
    task_definition = json.load(f)

task_definition["family"] = \
    "app-1-${environment}-backend"

for container in task_definition["containerDefinitions"]:

    if container["name"] == "backend":

        container["image"] = \
            "${imageUri}"

# Remove fields returned by describe-task-definition
# which are not accepted during registration.

remove_fields = [
    "taskDefinitionArn",
    "revision",
    "status",
    "requiresAttributes",
    "compatibilities",
    "registeredAt",
    "registeredBy"
]

for field in remove_fields:

    task_definition.pop(
        field,
        None
    )

with open("${taskDefinitionFile}", "w") as f:

    json.dump(
        task_definition,
        f,
        indent=2
    )

print("Task definition created:")
print("${taskDefinitionFile}")

print("Image:")
print("${imageUri}")
PYTHON


            echo "Registering ECS task definition..."

            REVISION=\$(aws ecs register-task-definition \
                --cli-input-json file://${taskDefinitionFile} \
                --region ${env.AWS_REGION} \
                --query 'taskDefinition.revision' \
                --output text)

            echo "Registered revision: \$REVISION"


            echo "Updating ECS service..."

            aws ecs update-service \
                --cluster app-1-${environment}-cluster \
                --service app-1-${environment}-backend-service \
                --task-definition app-1-${environment}-backend:\$REVISION \
                --force-new-deployment \
                --region ${env.AWS_REGION}


            echo "Waiting for ECS service to become stable..."

            aws ecs wait services-stable \
                --cluster app-1-${environment}-cluster \
                --services app-1-${environment}-backend-service \
                --region ${env.AWS_REGION}


            echo "============================================================"
            echo "Backend ${environment} deployment completed."
            echo "Image: ${imageUri}"
            echo "============================================================"
        """
    }
}

