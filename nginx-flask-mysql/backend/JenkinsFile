
pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select environment'
        )

        string(
            name: 'DEV_IMAGE_TAG',
            defaultValue: '',
            description: 'Enter the DEV image tag to promote, e.g. DEV-def5678-25'
        )
    }

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'
        AWS_CRED       = 'AWS'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"


        /*
         * ============================================================
         * SEPARATE ECR REPOSITORIES FOR EACH ENVIRONMENT
         * ============================================================
         */

        DEV_REPO  = 'app-1-backend-dev'
        QA_REPO   = 'app-1-backend-qa'
        UAT_REPO  = 'app-1-backend-uat'
        PROD_REPO = 'app-1-backend-prod'


        BUILD_CONTEXT =
            './nginx-flask-mysql/backend'

        TASK_DEFINITION_TEMPLATE =
            './nginx-flask-mysql/backend/task-definition.json'
    }


    stages {


        /*
         * ============================================================
         * DEV - BUILD IMAGE
         * ============================================================
         */

        stage('DEV - Build Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    def commitId = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()


                    /*
                     * Image tag:
                     *
                     * DEV-<commit>-<jenkins-build-number>
                     *
                     * Example:
                     * DEV-aad9cbf-25
                     */

                    def imageTag =
                        "DEV-${commitId}-${env.BUILD_NUMBER}"


                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"


                    echo "======================================"
                    echo "ENVIRONMENT  = dev"
                    echo "COMMIT ID    = ${commitId}"
                    echo "BUILD NUMBER = ${env.BUILD_NUMBER}"
                    echo "IMAGE TAG    = ${imageTag}"
                    echo "DEV REPO     = ${env.DEV_REPO}"
                    echo "IMAGE URI    = ${imageUri}"
                    echo "======================================"


                    env.IMAGE_URI = imageUri


                    echo "Building backend Docker image..."


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }


                    echo "Docker image build completed successfully."
                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }


        /*
         * ============================================================
         * DEV - PUSH IMAGE
         * ============================================================
         */

        stage('DEV - Push Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    if (!env.IMAGE_URI?.trim()) {

                        error(
                            "IMAGE_URI is empty. " +
                            "Make sure the DEV - Build Image stage completed successfully."
                        )
                    }


                    echo "Pushing backend Docker image..."
                    echo "DEV REPOSITORY = ${env.DEV_REPO}"
                    echo "IMAGE URI = ${env.IMAGE_URI}"


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(env.IMAGE_URI).push()
                    }


                    echo "Docker image pushed successfully."
                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }


        /*
         * ============================================================
         * QA - PROMOTE DEV IMAGE TO QA REPOSITORY
         * ============================================================
         */

        stage('QA - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }

            steps {

                script {

                    if (!params.DEV_IMAGE_TAG?.trim()) {

                        error(
                            "DEV_IMAGE_TAG is required for QA promotion."
                        )
                    }


                    def sourceTag = params.DEV_IMAGE_TAG


                    /*
                     * SOURCE:
                     * DEV ECR repository
                     */

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${sourceTag}"


                    /*
                     * TARGET:
                     * QA ECR repository
                     *
                     * DEV-aad9cbf-25
                     * becomes
                     * QA-aad9cbf-25
                     */

                    def targetTag =
                        "QA-${sourceTag.replaceFirst('^DEV-', '')}"


                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.QA_REPO}:${targetTag}"


                    echo "======================================"
                    echo "PROMOTION: DEV -> QA"
                    echo "SOURCE REPO = ${env.DEV_REPO}"
                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET REPO = ${env.QA_REPO}"
                    echo "TARGET IMAGE = ${targetImage}"
                    echo "======================================"


                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${env.AWS_CRED}"]
                    ]) {

                        sh """
                            set -e

                            echo "Logging in to ECR..."

                            aws ecr get-login-password \
                                --region ${env.AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin ${env.ECR_REGISTRY}


                            echo "Pulling DEV image..."

                            docker pull ${sourceImage}


                            echo "Tagging image for QA..."

                            docker tag \
                                ${sourceImage} \
                                ${targetImage}


                            echo "Pushing image to QA ECR repository..."

                            docker push ${targetImage}


                            echo "QA promotion completed successfully."
                        """
                    }


                    env.IMAGE_URI = targetImage


                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }


        /*
         * ============================================================
         * UAT - PROMOTE DEV IMAGE TO UAT REPOSITORY
         * ============================================================
         */

        stage('UAT - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }

            steps {

                script {

                    if (!params.DEV_IMAGE_TAG?.trim()) {

                        error(
                            "DEV_IMAGE_TAG is required for UAT promotion."
                        )
                    }


                    def sourceTag = params.DEV_IMAGE_TAG


                    /*
                     * SOURCE:
                     * DEV ECR repository
                     */

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${sourceTag}"


                    /*
                     * TARGET:
                     * UAT ECR repository
                     */

                    def targetTag =
                        "UAT-${sourceTag.replaceFirst('^DEV-', '')}"


                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.UAT_REPO}:${targetTag}"


                    echo "======================================"
                    echo "PROMOTION: DEV -> UAT"
                    echo "SOURCE REPO = ${env.DEV_REPO}"
                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET REPO = ${env.UAT_REPO}"
                    echo "TARGET IMAGE = ${targetImage}"
                    echo "======================================"


                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${env.AWS_CRED}"]
                    ]) {

                        sh """
                            set -e

                            echo "Logging in to ECR..."

                            aws ecr get-login-password \
                                --region ${env.AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin ${env.ECR_REGISTRY}


                            echo "Pulling DEV image..."

                            docker pull ${sourceImage}


                            echo "Tagging image for UAT..."

                            docker tag \
                                ${sourceImage} \
                                ${targetImage}


                            echo "Pushing image to UAT ECR repository..."

                            docker push ${targetImage}


                            echo "UAT promotion completed successfully."
                        """
                    }


                    env.IMAGE_URI = targetImage


                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }


        /*
         * ============================================================
         * PROD - PROMOTE DEV IMAGE TO PROD REPOSITORY
         * ============================================================
         */

        stage('PROD - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'prod'
                }
            }

            steps {

                script {

                    if (!params.DEV_IMAGE_TAG?.trim()) {

                        error(
                            "DEV_IMAGE_TAG is required for PROD promotion."
                        )
                    }


                    def sourceTag = params.DEV_IMAGE_TAG


                    /*
                     * SOURCE:
                     * DEV ECR repository
                     */

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${sourceTag}"


                    /*
                     * TARGET:
                     * PROD ECR repository
                     */

                    def targetTag =
                        "PROD-${sourceTag.replaceFirst('^DEV-', '')}"


                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.PROD_REPO}:${targetTag}"


                    echo "======================================"
                    echo "PROMOTION: DEV -> PROD"
                    echo "SOURCE REPO = ${env.DEV_REPO}"
                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET REPO = ${env.PROD_REPO}"
                    echo "TARGET IMAGE = ${targetImage}"
                    echo "======================================"


                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${env.AWS_CRED}"]
                    ]) {

                        sh """
                            set -e

                            echo "Logging in to ECR..."

                            aws ecr get-login-password \
                                --region ${env.AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin ${env.ECR_REGISTRY}


                            echo "Pulling DEV image..."

                            docker pull ${sourceImage}


                            echo "Tagging image for PROD..."

                            docker tag \
                                ${sourceImage} \
                                ${targetImage}


                            echo "Pushing image to PROD ECR repository..."

                            docker push ${targetImage}


                            echo "PROD promotion completed successfully."
                        """
                    }


                    env.IMAGE_URI = targetImage


                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }


        /*
         * ============================================================
         * CREATE ECS TASK DEFINITION
         * ============================================================
         */

        stage('Create Task Definition') {

            steps {

                script {

                    if (!env.IMAGE_URI?.trim()) {

                        error("IMAGE_URI is empty.")
                    }


                    echo "IMAGE URI = ${env.IMAGE_URI}"
                    echo "ENVIRONMENT = ${params.ENVIRONMENT}"


                    sh """
                        set -e

                        ENVIRONMENT="${params.ENVIRONMENT}" \
                        IMAGE_URI="${env.IMAGE_URI}" \
                        TASK_DEFINITION_TEMPLATE="${env.TASK_DEFINITION_TEMPLATE}" \
                        python3 - <<'PY'

import json
import os

input_file = os.environ["TASK_DEFINITION_TEMPLATE"]
output_file = "new-backend-task-definition.json"

environment = os.environ["ENVIRONMENT"]
image_uri = os.environ["IMAGE_URI"]


with open(input_file, "r") as f:
    task_definition = json.load(f)


task_definition["family"] = f"app-1-{environment}-backend"


for container in task_definition["containerDefinitions"]:

    if container["name"] == "backend":

        container["image"] = image_uri
        break

else:

    raise Exception(
        "Container named 'backend' was not found."
    )


with open(output_file, "w") as f:

    json.dump(
        task_definition,
        f,
        indent=2
    )

PY


                        echo "Generated task definition:"

                        cat new-backend-task-definition.json
                    """
                }
            }
        }


        /*
         * ============================================================
         * REGISTER TASK DEFINITION + UPDATE ECS SERVICE
         * ============================================================
         */

        stage('Register and Update ECS Service') {

            steps {

                script {

                    def revision = ""


                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${env.AWS_CRED}"]
                    ]) {

                        revision = sh(
                            script: """
                                set -e

                                aws sts get-caller-identity

                                aws ecs register-task-definition \
                                    --cli-input-json file://new-backend-task-definition.json \
                                    --region ${env.AWS_REGION} \
                                    --query 'taskDefinition.revision' \
                                    --output text
                            """,
                            returnStdout: true
                        ).trim()
                    }


                    echo "AWS REGISTERED REVISION = '${revision}'"


                    if (!revision ||
                        revision == 'null' ||
                        revision == 'None') {

                        error(
                            "ECS returned invalid revision: '${revision}'"
                        )
                    }


                    def environment =
                        params.ENVIRONMENT


                    def cluster =
                        "app-1-${environment}-cluster"


                    def service =
                        "app-1-${environment}-backend-service"


                    def taskFamily =
                        "app-1-${environment}-backend"


                    echo "======================================"
                    echo "ENVIRONMENT = ${environment}"
                    echo "CLUSTER = ${cluster}"
                    echo "SERVICE = ${service}"
                    echo "TASK FAMILY = ${taskFamily}"
                    echo "TASK REVISION = ${revision}"
                    echo "IMAGE URI = ${env.IMAGE_URI}"
                    echo "======================================"


                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${env.AWS_CRED}"]
                    ]) {

                        sh """
                            set -e

                            echo "Updating ECS service..."

                            aws ecs update-service \
                                --cluster ${cluster} \
                                --service ${service} \
                                --task-definition ${taskFamily}:${revision} \
                                --force-new-deployment \
                                --region ${env.AWS_REGION}


                            echo "Waiting for ECS service to become stable..."

                            aws ecs wait services-stable \
                                --cluster ${cluster} \
                                --services ${service} \
                                --region ${env.AWS_REGION}


                            echo "ECS deployment completed successfully."
                        """
                    }


                    echo "ECS ${environment} deployment completed successfully."
                }
            }
        }
    }
}

