{
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "python:3.10-alpine",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "name": "backend"
        }
      ],
      "essential": true,
      "environment": [
  {
    "name": "MYSQL_HOST",
    "value": "app1-db"
  },
  {
    "name": "MYSQL_DATABASE",
    "value": "example"
  },
  {
    "name": "MYSQL_USER",
    "value": "root"
  }
],
      "mountPoints": [],
      "volumesFrom": [],
      "systemControls": []
    }
  ],
  "family": "app-1-dev-backend",
  "executionRoleArn": "arn:aws:iam::552940445807:role/app-1-ecs-execution-role",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
