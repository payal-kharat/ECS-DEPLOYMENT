{
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "552940445807.dkr.ecr.us-east-1.amazonaws.com/app-1-backend-dev:DEV-461213c-7",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp",
          "name": "backend"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "MYSQL_DATABASE",
          "value": "example"
        },
        {
          "name": "MYSQL_HOST",
          "value": "app1-db.app1.local"
        },
        {
          "name": "MYSQL_USER",
          "value": "root"
        },
        {
          "name": "DB_PASSWORD",
          "value": "rootpassword"
        }
      ],
      "mountPoints": [],
      "volumesFrom": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/app-1-dev-db",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "app-1-dev-backend",
  "executionRoleArn": "arn:aws:iam::552940445807:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512"
}
