
pipeline {

    agent any

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        AWS_CRED = 'aws-ecr-credentials'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"


        // ============================================================
        // SEPARATE ECR REPOSITORIES
        // ============================================================

        DEV_REPO  = 'app-1-frontend-dev'
        QA_REPO   = 'app-1-frontend-qa'
        UAT_REPO  = 'app-1-frontend-uat'
        PROD_REPO = 'app-1-frontend-prod'


        // ============================================================
        // DOCKER BUILD LOCATION
        // ============================================================

        BUILD_CONTEXT =
            './nginx-flask-mysql/frontend'


        // ============================================================
        // ECS TASK DEFINITION TEMPLATE
        // ============================================================

        TASK_DEFINITION_TEMPLATE =
            './nginx-flask-mysql/frontend/task-definition.json'
    }


    stages {


        // ============================================================
        // 1. CHECKOUT
        // ============================================================

        stage('Checkout') {

            steps {

                checkout scm

                script {

                    env.COMMIT_ID =
                        sh(
                            script: 'git rev-parse --short=7 HEAD',
                            returnStdout: true
                        ).trim()

                    echo "======================================"
                    echo "COMMIT ID = ${env.COMMIT_ID}"
                    echo "======================================"
                }
            }
        }


        // ============================================================
        // 2. DEV - BUILD IMAGE
        // ============================================================

        stage('DEV - Build Image') {

            steps {

                script {

                    /*
                     * Example:
                     *
                     * DEV-370e229-25
                     */

                    def imageTag =
                        "DEV-${env.COMMIT_ID}-${env.BUILD_NUMBER}"


                    env.DEV_IMAGE_TAG = imageTag


                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"


                    env.DEV_IMAGE_URI = imageUri


                    echo "======================================"
                    echo "BUILD ENVIRONMENT = DEV"
                    echo "COMMIT ID         = ${env.COMMIT_ID}"
                    echo "IMAGE TAG         = ${imageTag}"
                    echo "DEV REPOSITORY    = ${env.DEV_REPO}"
                    echo "IMAGE URI         = ${imageUri}"
                    echo "======================================"


                    echo "Building FRONTEND Docker image..."


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }


                    echo "Frontend Docker image built successfully."
                }
            }
        }


        // ============================================================
        // 3. DEV - PUSH IMAGE
        // ============================================================

        stage('DEV - Push Image') {

            steps {

                script {

                    if (!env.DEV_IMAGE_URI?.trim()) {

                        error(
                            "DEV_IMAGE_URI is empty. " +
                            "DEV image was not built successfully."
                        )
                    }


                    echo "======================================"
                    echo "PUSHING FRONTEND IMAGE"
                    echo "DEV REPOSITORY = ${env.DEV_REPO}"
                    echo "IMAGE URI       = ${env.DEV_IMAGE_URI}"
                    echo "======================================"


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(
                            env.DEV_IMAGE_URI
                        ).push()
                    }


                    echo "Frontend DEV image pushed successfully."
                }
            }
        }


        // ============================================================
        // 4. DEPLOY DEV
        // ============================================================

        stage('Deploy Frontend - DEV') {

            steps {

                script {

                    deployFrontend(
                        'dev',
                        env.DEV_REPO,
                        env.DEV_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 5. DEV → QA PROMOTION
        // ============================================================

        stage('QA - Promote Image') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.QA_REPO,
                        env.DEV_IMAGE_TAG,
                        'QA'
                    )


                    env.QA_IMAGE_TAG =
                        "QA-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"


                    env.QA_IMAGE_URI =
                        "${env.ECR_REGISTRY}/${env.QA_REPO}:${env.QA_IMAGE_TAG}"
                }
            }
        }


        // ============================================================
        // 6. DEPLOY QA
        // ============================================================

        stage('Deploy Frontend - QA') {

            steps {

                script {

                    deployFrontend(
                        'qa',
                        env.QA_REPO,
                        env.QA_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 7. DEV → UAT PROMOTION
        // ============================================================

        stage('UAT - Promote Image') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.UAT_REPO,
                        env.DEV_IMAGE_TAG,
                        'UAT'
                    )


                    env.UAT_IMAGE_TAG =
                        "UAT-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"


                    env.UAT_IMAGE_URI =
                        "${env.ECR_REGISTRY}/${env.UAT_REPO}:${env.UAT_IMAGE_TAG}"
                }
            }
        }


        // ============================================================
        // 8. DEPLOY UAT
        // ============================================================

        stage('Deploy Frontend - UAT') {

            steps {

                script {

                    deployFrontend(
                        'uat',
                        env.UAT_REPO,
                        env.UAT_IMAGE_TAG
                    )
                }
            }
        }


        // ============================================================
        // 9. PRODUCTION APPROVAL
        // ============================================================

        stage('Production Approval') {

            steps {

                input(
                    message:
                        'DEV, QA and UAT frontend deployment completed. Deploy Frontend to PROD?',

                    ok:
                        'Deploy to PROD'
                )
            }
        }


        // ============================================================
        // 10. DEV → PROD PROMOTION
        // ============================================================

        stage('PROD - Promote Image') {

            steps {

                script {

                    promoteImage(
                        env.DEV_REPO,
                        env.PROD_REPO,
                        env.DEV_IMAGE_TAG,
                        'PROD'
                    )


                    env.PROD_IMAGE_TAG =
                        "PROD-${env.DEV_IMAGE_TAG.replaceFirst('^DEV-', '')}"


                    env.PROD_IMAGE_URI =
                        "${env.ECR_REGISTRY}/${env.PROD_REPO}:${env.PROD_IMAGE_TAG}"
                }
            }
        }


        // ============================================================
        // 11. DEPLOY PROD
        // ============================================================

        stage('Deploy Frontend - PROD') {

            steps {

                script {

                    deployFrontend(
                        'prod',
                        env.PROD_REPO,
                        env.PROD_IMAGE_TAG
                    )
                }
            }
        }
    }


    // ================================================================
    // POST ACTIONS
    // ================================================================

    post {

        always {

            echo 'Cleaning Jenkins workspace...'

            cleanWs()
        }


        success {

            echo '''
============================================================
Frontend ECS CI/CD completed successfully.

DEV  → QA → UAT → PROD

Frontend image was built ONLY ONCE in DEV.

The same image was promoted to:
    DEV
    QA
    UAT
    PROD

No rebuild was performed in QA, UAT or PROD.
============================================================
'''
        }


        failure {

            echo '''
============================================================
Frontend ECS CI/CD FAILED.

Check the Jenkins console output.
============================================================
'''
        }
    }
}


// ====================================================================
// FUNCTION: PROMOTE IMAGE
// ====================================================================

def promoteImage(
    String sourceRepo,
    String targetRepo,
    String sourceTag,
    String targetEnvironment
) {

    def sourceImage =
        "${env.ECR_REGISTRY}/${sourceRepo}:${sourceTag}"


    def targetTag =
        "${targetEnvironment}-${sourceTag.replaceFirst('^DEV-', '')}"


    def targetImage =
        "${env.ECR_REGISTRY}/${targetRepo}:${targetTag}"


    echo "============================================================"
    echo "PROMOTING FRONTEND IMAGE"
    echo "============================================================"
    echo "SOURCE REPOSITORY : ${sourceRepo}"
    echo "SOURCE IMAGE      : ${sourceImage}"
    echo "TARGET REPOSITORY : ${targetRepo}"
    echo "TARGET IMAGE      : ${targetImage}"
    echo "============================================================"


    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"

            aws sts get-caller-identity


            echo "Logging in to ECR..."

            aws ecr get-login-password \
                --region ${env.AWS_REGION} \
                | docker login \
                    --username AWS \
                    --password-stdin ${env.ECR_REGISTRY}


            echo "Pulling DEV image..."

            docker pull ${sourceImage}


            echo "Tagging image..."

            docker tag \
                ${sourceImage} \
                ${targetImage}


            echo "Pushing promoted image..."

            docker push ${targetImage}


            echo "============================================================"
            echo "PROMOTION COMPLETED"
            echo "TARGET IMAGE: ${targetImage}"
            echo "============================================================"
        """
    }
}


// ====================================================================
// FUNCTION: DEPLOY FRONTEND TO ECS
// ====================================================================

def deployFrontend(
    String environment,
    String repository,
    String imageTag
) {

    def imageUri =
        "${env.ECR_REGISTRY}/${repository}:${imageTag}"


    def taskDefinitionFile =
        "new-frontend-task-definition-${environment}.json"


    echo "============================================================"
    echo "DEPLOYING FRONTEND"
    echo "============================================================"
    echo "Environment : ${environment}"
    echo "Repository  : ${repository}"
    echo "Image Tag   : ${imageTag}"
    echo "Image URI   : ${imageUri}"
    echo "============================================================"


    withCredentials([
        [
            $class: 'AmazonWebServicesCredentialsBinding',
            credentialsId: "${env.AWS_CRED}"
        ]
    ]) {

        sh """
            set -e

            echo "AWS Identity:"

            aws sts get-caller-identity


            echo "Creating ECS task definition for ${environment}..."


            python3 - <<PYTHON

import json


# Read original task definition

with open("${env.TASK_DEFINITION_TEMPLATE}") as f:

    task_definition = json.load(f)


# Set environment-specific family

task_definition["family"] = \
    "app-1-${environment}-frontend"


# Update frontend container image

for container in task_definition["containerDefinitions"]:

    if container["name"] == "frontend":

        container["image"] = \
            "${imageUri}"


# Remove AWS-generated fields
# before registering the task definition

remove_fields = [

    "taskDefinitionArn",

    "revision",

    "status",

    "requiresAttributes",

    "compatibilities",

    "registeredAt",

    "registeredBy"
]


for field in remove_fields:

    task_definition.pop(
        field,
        None
    )


# Save environment-specific task definition

with open("${taskDefinitionFile}", "w") as f:

    json.dump(
        task_definition,
        f,
        indent=2
    )


print("Task definition created:")
print("${taskDefinitionFile}")


print("Frontend image:")
print("${imageUri}")

PYTHON


            echo "Registering ECS task definition..."


            REVISION=\$(aws ecs register-task-definition \
                --cli-input-json file://${taskDefinitionFile} \
                --region ${env.AWS_REGION} \
                --query 'taskDefinition.revision' \
                --output text)


            echo "Registered revision: \$REVISION"


            echo "Updating ECS frontend service..."


            aws ecs update-service \
                --cluster app-1-${environment}-cluster \
                --service app-1-${environment}-frontend-service \
                --task-definition app-1-${environment}-frontend:\$REVISION \
                --force-new-deployment \
                --region ${env.AWS_REGION}


            echo "Waiting for ECS frontend service to become stable..."


            aws ecs wait services-stable \
                --cluster app-1-${environment}-cluster \
                --services app-1-${environment}-frontend-service \
                --region ${env.AWS_REGION}


            echo "============================================================"
            echo "Frontend ${environment} deployment completed."
            echo "Image: ${imageUri}"
            echo "============================================================"
        """
    }
}

