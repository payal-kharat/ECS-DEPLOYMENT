
pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select environment'
        )

        string(
            name: 'DEV_IMAGE_TAG',
            defaultValue: '',
            description: 'Enter the DEV image tag to promote, e.g. DEV-370e229'
        )
    }

    environment {

        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        AWS_CRED = 'aws-ecr-credentials'

        ECR_REGISTRY =
            "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"


        /*
         * ============================================================
         * SEPARATE ECR REPOSITORIES
         * ============================================================
         */

        DEV_REPO  = 'app-1-frontend-dev'
        QA_REPO   = 'app-1-frontend-qa'
        UAT_REPO  = 'app-1-frontend-uat'
        PROD_REPO = 'app-1-frontend-prod'


        BUILD_CONTEXT =
            './nginx-flask-mysql/frontend'

        TASK_DEFINITION_TEMPLATE =
            './nginx-flask-mysql/frontend/task-definition.json'
    }


    stages {


        /*
         * ============================================================
         * DEV - BUILD IMAGE
         * ============================================================
         */

        stage('DEV - Build Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    def commitId = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()


                    /*
                     * Example:
                     *
                     * DEV-370e229
                     */

                    def imageTag =
                        "DEV-${commitId}"


                    def imageUri =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${imageTag}"


                    echo "======================================"
                    echo "ENVIRONMENT = dev"
                    echo "COMMIT ID   = ${commitId}"
                    echo "IMAGE TAG   = ${imageTag}"
                    echo "DEV REPO    = ${env.DEV_REPO}"
                    echo "IMAGE URI   = ${imageUri}"
                    echo "======================================"


                    env.IMAGE_URI = imageUri


                    echo "Building FRONTEND Docker image..."


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.build(
                            imageUri,
                            env.BUILD_CONTEXT
                        )
                    }


                    echo "Docker image build completed successfully."
                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }


        /*
         * ============================================================
         * DEV - PUSH IMAGE
         * ============================================================
         */

        stage('DEV - Push Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'dev'
                }
            }

            steps {

                script {

                    if (!env.IMAGE_URI?.trim()) {

                        error(
                            "IMAGE_URI is empty. " +
                            "Make sure the DEV - Build Image stage completed successfully."
                        )
                    }


                    echo "Pushing FRONTEND Docker image..."
                    echo "DEV REPOSITORY = ${env.DEV_REPO}"
                    echo "IMAGE URI = ${env.IMAGE_URI}"


                    docker.withRegistry(
                        "https://${env.ECR_REGISTRY}",
                        "ecr:${env.AWS_REGION}:${env.AWS_CRED}"
                    ) {

                        docker.image(env.IMAGE_URI).push()
                    }


                    echo "Docker image pushed successfully."
                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }


        /*
         * ============================================================
         * QA - PROMOTE DEV IMAGE TO QA REPOSITORY
         * ============================================================
         */

        stage('QA - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'qa'
                }
            }

            steps {

                script {

                    def sourceTag =
                        params.DEV_IMAGE_TAG


                    if (!sourceTag?.trim()) {

                        error(
                            "DEV_IMAGE_TAG is required when promoting to QA."
                        )
                    }


                    /*
                     * SOURCE:
                     * DEV ECR repository
                     */

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${sourceTag}"


                    /*
                     * TARGET:
                     * QA ECR repository
                     *
                     * DEV-370e229
                     * becomes
                     * QA-370e229
                     */

                    def targetTag =
                        "QA-${sourceTag.replaceFirst('^DEV-', '')}"


                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.QA_REPO}:${targetTag}"


                    echo "======================================"
                    echo "PROMOTION: DEV -> QA"
                    echo "SOURCE REPO  = ${env.DEV_REPO}"
                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET REPO  = ${env.QA_REPO}"
                    echo "TARGET IMAGE = ${targetImage}"
                    echo "======================================"


                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${env.AWS_CRED}"]
                    ]) {

                        sh """
                            set -e

                            echo "Logging in to ECR..."

                            aws ecr get-login-password \
                                --region ${env.AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin ${env.ECR_REGISTRY}


                            echo "Pulling DEV image..."

                            docker pull ${sourceImage}


                            echo "Tagging image for QA..."

                            docker tag \
                                ${sourceImage} \
                                ${targetImage}


                            echo "Pushing image to QA ECR repository..."

                            docker push ${targetImage}


                            echo "QA promotion completed successfully."
                        """
                    }


                    env.IMAGE_URI = targetImage


                    echo "IMAGE_URI = ${env.IMAGE_URI}"
                }
            }
        }


        /*
         * ============================================================
         * UAT - PROMOTE DEV IMAGE TO UAT REPOSITORY
         * ============================================================
         */

        stage('UAT - Promote Image') {

            when {
                expression {
                    params.ENVIRONMENT == 'uat'
                }
            }

            steps {

                script {

                    def sourceTag =
                        params.DEV_IMAGE_TAG


                    if (!sourceTag?.trim()) {

                        error(
                            "DEV_IMAGE_TAG is required when promoting to UAT."
                        )
                    }


                    /*
                     * SOURCE:
                     * DEV ECR repository
                     */

                    def sourceImage =
                        "${env.ECR_REGISTRY}/${env.DEV_REPO}:${sourceTag}"


                    /*
                     * TARGET:
                     * UAT ECR repository
                     */

                    def targetTag =
                        "UAT-${sourceTag.replaceFirst('^DEV-', '')}"


                    def targetImage =
                        "${env.ECR_REGISTRY}/${env.UAT_REPO}:${targetTag}"


                    echo "======================================"
                    echo "PROMOTION: DEV -> UAT"
                    echo "SOURCE REPO  = ${env.DEV_REPO}"
                    echo "SOURCE IMAGE = ${sourceImage}"
                    echo "TARGET REPO  = ${env.UAT_REPO}"
                    echo "TARGET IMAGE = ${targetImage}"
                    echo "======================================"


                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${env.AWS_CRED}"]
                    ]) {

                        sh """
                            set -e

                            echo "Logging in to ECR..."

                            aws ecr get-login-password \
                                --region ${env.AWS_REGION} | \
                            docker login \
                                --username AWS \
                                --password-stdin ${env.ECR_REGISTRY}


                            echo "Pulling DEV image..."

                            docker pull ${sourceImage}


                            echo "Tagging image for UAT..."

                            docker tag \
                                ${sourceImage} \
                                ${targetImage}


                            echo "Pushing image to UAT ECR repository..."

                            docker push ${targetImage}


