      ],
      "Resource": [
        "arn:aws:ecr:us-east-1:552940445807:repository/jenkins-ecs-deployment-frontend",
        "arn:aws:ecr:us-east-1:552940445807:repository/jenkins-ecs-deployment-backend",
        "arn:aws:ecr:us-east-1:552940445807:repository/jenkins-ecs-deployment-db"
      ]
    }
  ]
}