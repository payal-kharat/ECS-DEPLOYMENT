pipeline {
    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'QA', 'UAT', 'PROD'],
            description: 'Select the environment where you want to deploy DB'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Leave empty to use Jenkins BUILD_NUMBER'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        ECR_REGISTRY = '552940445807.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPOSITORY = 'jenkins-ecs-deployment-db'

        PROJECT = 'jenkins-ecs-deployment'

        DB_CONTAINER = 'db'

        DB_CONTEXT = './APP-1/nginx-flask-mysql/db'
    }

    stages {

        /*
         * CHECKOUT
         */
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
       stage('Prepare Deployment Script') {
    steps {
        sh '''
            set -e

            chmod +x ./APP-1/deploy-ecs-image.sh

            ls -l ./APP-1/deploy-ecs-image.sh
        '''
    }
}


        /*
         * IMAGE TAG
         */
        stage('Set Image Tag') {
            steps {
                script {

                    if (params.IMAGE_TAG?.trim()) {
                        env.IMAGE_TAG = params.IMAGE_TAG.trim()
                    } else {
                        env.IMAGE_TAG = "${BUILD_NUMBER}"
                    }

                    env.DB_IMAGE =
                        "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                    echo "========================================"
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Image Tag   : ${env.IMAGE_TAG}"
                    echo "DB Image    : ${env.DB_IMAGE}"
                    echo "========================================"
                }
            }
        }

        /*
         * ECR LOGIN
         */
        stage('ECR Login') {
            steps {
                sh '''
                    set -e

                    aws ecr get-login-password \
                        --region "$AWS_REGION" |
                    docker login \
                        --username AWS \
                        --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        /*
         * BUILD DB IMAGE
         */
        stage('Build DB Image') {
            steps {
                sh '''
                    set -e

                    echo "Building DB image..."

                    docker build \
                        -t "$DB_IMAGE" \
                        "$DB_CONTEXT"

                    echo "DB image built successfully."
                '''
            }
        }

        /*
         * PUSH DB IMAGE
         */
        stage('Push DB Image') {
            steps {
                sh '''
                    set -e

                    echo "Pushing DB image..."

                    docker push "$DB_IMAGE"

                    echo "DB image pushed successfully."
                '''
            }
        }

        /*
         * DEV
         */
        stage('Deploy DEV') {

            when {
                expression {
                    params.ENVIRONMENT == 'DEV'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Deploying DB to DEV..."

                    ./APP-1/deploy-ecs-image.sh \
                        "$PROJECT-dev-cluster" \
                        "$PROJECT-dev-db-service" \
                        "$DB_IMAGE" \
                        "$DB_CONTAINER"

                    echo "DEV DB deployment completed."
                '''
            }
        }

        /*
         * QA
         */
        stage('Deploy QA') {

            when {
                expression {
                    params.ENVIRONMENT == 'QA'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Deploying DB to QA..."

                    ./APP-1/deploy-ecs-image.sh \
                        "$PROJECT-qa-cluster" \
                        "$PROJECT-qa-db-service" \
                        "$DB_IMAGE" \
                        "$DB_CONTAINER"

                    echo "QA DB deployment completed."
                '''
            }
        }

        /*
         * UAT
         */
        stage('Deploy UAT') {

            when {
                expression {
                    params.ENVIRONMENT == 'UAT'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Deploying DB to UAT..."

                    ./APP-1/deploy-ecs-image.sh \
                        "$PROJECT-uat-cluster" \
                        "$PROJECT-uat-db-service" \
                        "$DB_IMAGE" \
                        "$DB_CONTAINER"

                    echo "UAT DB deployment completed."
                '''
            }
        }

        /*
         * PROD APPROVAL
         */
        stage('Approve PROD Deployment') {

            when {
                expression {
                    params.ENVIRONMENT == 'PROD'
                }
            }

            steps {
                input(
                    message: "Approve deployment of ${env.DB_IMAGE} to PROD?",
                    ok: "Approve PROD Deployment"
                )
            }
        }

        /*
         * PROD
         */
        stage('Deploy PROD') {

            when {
                expression {
                    params.ENVIRONMENT == 'PROD'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Deploying DB to PROD..."

                    ./APP-1/deploy-ecs-image.sh \
                        "$PROJECT-prod-cluster" \
                        "$PROJECT-prod-db-service" \
                        "$DB_IMAGE" \
                        "$DB_CONTAINER"

                    echo "PROD DB deployment completed."
                '''
            }
        }
    }

    /*
     * POST ACTIONS
     */
    post {

        success {
            echo """
            ================================================
            DB PIPELINE SUCCESS
            ================================================

            Environment:
            ${params.ENVIRONMENT}

            Image:
            ${env.DB_IMAGE}

            DB deployment completed successfully.

            ================================================
            """
        }

        failure {
            echo """
            ================================================
            DB PIPELINE FAILED
            ================================================

            Environment:
            ${params.ENVIRONMENT}

            Check the Jenkins console output.

            ================================================
            """
        }

        aborted {
            echo """
            ================================================
            DB PIPELINE ABORTED
            ================================================

            Environment:
            ${params.ENVIRONMENT}

            ================================================
            """
        }
    }
}
