pipeline {
    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'QA', 'UAT', 'PROD'],
            description: 'Select the environment where you want to deploy'
        )

        string(
            name: 'IMAGE_TAG',
            defaultValue: '',
            description: 'Leave empty to use Jenkins BUILD_NUMBER'
        )
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        ECR_REGISTRY = '552940445807.dkr.ecr.us-east-1.amazonaws.com'
        ECR_REPOSITORY = 'jenkins-ecs-deployment-backend'

        PROJECT = 'jenkins-ecs-deployment'

        BACKEND_CONTAINER = 'backend'

        BACKEND_CONTEXT = './APP-1/nginx-flask-mysql/backend'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Set Image Tag') {
            steps {
                script {

                    if (params.IMAGE_TAG?.trim()) {
                        env.IMAGE_TAG = params.IMAGE_TAG.trim()
                    } else {
                        env.IMAGE_TAG = "${BUILD_NUMBER}"
                    }

                    env.BACKEND_IMAGE =
                        "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"

                    echo "========================================"
                    echo "Environment : ${params.ENVIRONMENT}"
                    echo "Image Tag   : ${env.IMAGE_TAG}"
                    echo "Backend Image:"
                    echo "${env.BACKEND_IMAGE}"
                    echo "========================================"
                }
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    set -e

                    aws ecr get-login-password \
                        --region "$AWS_REGION" |
                    docker login \
                        --username AWS \
                        --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Build Backend Image') {
            steps {
                sh '''
                    set -e

                    echo "Building backend image..."

                    docker build \
                        -t "$BACKEND_IMAGE" \
                        "$BACKEND_CONTEXT"

                    echo "Backend image built successfully."
                '''
            }
        }

        stage('Push Backend Image') {
            steps {
                sh '''
                    set -e

                    echo "Pushing backend image..."

                    docker push "$BACKEND_IMAGE"

                    echo "Backend image pushed successfully."
                '''
            }
        }

        /*
         * DEV DEPLOYMENT
         */
        stage('Deploy DEV') {
            when {
                expression {
                    params.ENVIRONMENT == 'DEV'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Deploying backend to DEV..."

                    ./APP-1/deploy-ecs-image.sh \
                        "$PROJECT-dev-cluster" \
                        "$PROJECT-dev-backend-service" \
                        "$BACKEND_IMAGE" \
                        "$BACKEND_CONTAINER"

                    echo "DEV deployment completed."
                '''
            }
        }

        /*
         * QA DEPLOYMENT
         */
        stage('Deploy QA') {
            when {
                expression {
                    params.ENVIRONMENT == 'QA'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Deploying backend to QA..."

                    ./APP-1/deploy-ecs-image.sh \
                        "$PROJECT-qa-cluster" \
                        "$PROJECT-qa-backend-service" \
                        "$BACKEND_IMAGE" \
                        "$BACKEND_CONTAINER"

                    echo "QA deployment completed."
                '''
            }
        }

        /*
         * UAT DEPLOYMENT
         */
        stage('Deploy UAT') {
            when {
                expression {
                    params.ENVIRONMENT == 'UAT'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Deploying backend to UAT..."

                    ./APP-1/deploy-ecs-image.sh \
                        "$PROJECT-uat-cluster" \
                        "$PROJECT-uat-backend-service" \
                        "$BACKEND_IMAGE" \
                        "$BACKEND_CONTAINER"

                    echo "UAT deployment completed."
                '''
            }
        }

        /*
         * PROD DEPLOYMENT
         */
        stage('Approve PROD Deployment') {
            when {
                expression {
                    params.ENVIRONMENT == 'PROD'
                }
            }

            steps {
                input(
                    message: "Approve deployment of ${env.BACKEND_IMAGE} to PROD?",
                    ok: "Approve PROD Deployment"
                )
            }
        }

        stage('Deploy PROD') {
            when {
                expression {
                    params.ENVIRONMENT == 'PROD'
                }
            }

            steps {
                sh '''
                    set -e

                    echo "Deploying backend to PROD..."

                    ./APP-1/deploy-ecs-image.sh \
                        "$PROJECT-prod-cluster" \
                        "$PROJECT-prod-backend-service" \
                        "$BACKEND_IMAGE" \
                        "$BACKEND_CONTAINER"

                    echo "PROD deployment completed."
                '''
            }
        }
    }

    post {

        success {
            echo """
            ================================================
            BACKEND PIPELINE SUCCESS
            ================================================

            Environment:
            ${params.ENVIRONMENT}

            Image:
            ${env.BACKEND_IMAGE}

            Deployment completed successfully.

            ================================================
            """
        }

        failure {
            echo """
            ================================================
            BACKEND PIPELINE FAILED
            ================================================

            Environment:
            ${params.ENVIRONMENT}

            Check the Jenkins console output.

            ================================================
            """
        }

        aborted {
            echo """
            ================================================
            BACKEND PIPELINE ABORTED
            ================================================

            Environment:
            ${params.ENVIRONMENT}

            ================================================
            """
        }
    }
}
