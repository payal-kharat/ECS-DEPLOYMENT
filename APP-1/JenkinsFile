
pipeline {

    agent any

    environment {

        // AWS
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '552940445807'

        // ECR
        ECR_REGISTRY = '552940445807.dkr.ecr.us-east-1.amazonaws.com'

        BACKEND_REPOSITORY = 'jenkins-ecs-deployment-backend'
        FRONTEND_REPOSITORY = 'jenkins-ecs-deployment-frontend'

        // ECS Task Definitions
        BACKEND_TASK_DEFINITION = 'jenkins-ecs-deployment-dev-backend'
        FRONTEND_TASK_DEFINITION = 'jenkins-ecs-deployment-dev-frontend'

        // IMPORTANT:
        // Replace these 3 values with your actual ECS names.
        ECS_CLUSTER = 'jenkins-ecs-deployment-dev-cluster'
        BACKEND_SERVICE = 'jenkins-ecs-deployment-dev-backend-service'
        FRONTEND_SERVICE = 'jenkins-ecs-deployment-dev-frontend-service'

        // Jenkins build number becomes Docker image tag
        IMAGE_TAG = "${BUILD_NUMBER}"

        // Complete ECR image names
        BACKEND_IMAGE = "${ECR_REGISTRY}/${BACKEND_REPOSITORY}:${BUILD_NUMBER}"
        FRONTEND_IMAGE = "${ECR_REGISTRY}/${FRONTEND_REPOSITORY}:${BUILD_NUMBER}"
    }

    stages {

        // ============================================================
        // 1. CHECKOUT SOURCE CODE
        // ============================================================

        stage('Checkout') {
            steps {
                checkout scm
            }
        }


        // ============================================================
        // 2. SHOW WORKSPACE
        // ============================================================

        stage('Check Workspace') {
            steps {
                sh '''
                    echo "======================================"
                    echo "Current Workspace"
                    echo "======================================"

                    pwd

                    echo ""
                    echo "Root directory:"
                    ls -la

                    echo ""
                    echo "Application structure:"
                    find APP-1/nginx-flask-mysql -maxdepth 2 -type f | sort
                '''
            }
        }


        // ============================================================
        // 3. BUILD BACKEND DOCKER IMAGE
        // ============================================================

        stage('Build Backend Image') {
            steps {
                sh '''
                    echo "Building Backend Docker Image..."

                    docker build \
                        -t ${BACKEND_REPOSITORY}:${IMAGE_TAG} \
                        ./APP-1/nginx-flask-mysql/backend
                '''
            }
        }


        // ============================================================
        // 4. BUILD PROXY / FRONTEND DOCKER IMAGE
        // ============================================================

        stage('Build Frontend Image') {
            steps {
                sh '''
                    echo "Building Frontend/Proxy Docker Image..."

                    docker build \
                        -t ${FRONTEND_REPOSITORY}:${IMAGE_TAG} \
                        ./APP-1/nginx-flask-mysql/proxy
                '''
            }
        }


        // ============================================================
        // 5. LOGIN TO ECR
        // ============================================================

        stage('Login to ECR') {
            steps {
                sh '''
                    echo "Logging into Amazon ECR..."

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}
                '''
            }
        }


        // ============================================================
        // 6. TAG BACKEND IMAGE
        // ============================================================

        stage('Tag Backend Image') {
            steps {
                sh '''
                    echo "Tagging Backend Image..."

                    docker tag \
                        ${BACKEND_REPOSITORY}:${IMAGE_TAG} \
                        ${BACKEND_IMAGE}

                    echo "Backend Image:"
                    echo "${BACKEND_IMAGE}"
                '''
            }
        }


        // ============================================================
        // 7. TAG FRONTEND IMAGE
        // ============================================================

        stage('Tag Frontend Image') {
            steps {
                sh '''
                    echo "Tagging Frontend Image..."

                    docker tag \
                        ${FRONTEND_REPOSITORY}:${IMAGE_TAG} \
                        ${FRONTEND_IMAGE}

                    echo "Frontend Image:"
                    echo "${FRONTEND_IMAGE}"
                '''
            }
        }


        // ============================================================
        // 8. PUSH BACKEND IMAGE TO ECR
        // ============================================================

        stage('Push Backend Image') {
            steps {
                sh '''
                    echo "Pushing Backend Image to ECR..."

                    docker push ${BACKEND_IMAGE}
                '''
            }
        }


        // ============================================================
        // 9. PUSH FRONTEND IMAGE TO ECR
        // ============================================================

        stage('Push Frontend Image') {
            steps {
                sh '''
                    echo "Pushing Frontend Image to ECR..."

                    docker push ${FRONTEND_IMAGE}
                '''
            }
        }


        // ============================================================
        // 10. CREATE NEW BACKEND TASK DEFINITION
        // ============================================================

        stage('Create Backend Task Definition') {
            steps {
                sh '''
                    echo "Getting current Backend Task Definition..."

                    aws ecs describe-task-definition \
                        --task-definition ${BACKEND_TASK_DEFINITION} \
                        --region ${AWS_REGION} \
                        --query taskDefinition \
                        --output json \
                        > backend-task-definition.json


                    echo "Updating Backend container image..."

                    jq --arg IMAGE "${BACKEND_IMAGE}" \
                        '(.containerDefinitions[] |
                          select(.name == "backend")).image = $IMAGE |
                         del(
                            .taskDefinitionArn,
                            .revision,
                            .status,
                            .requiresAttributes,
                            .compatibilities,
                            .registeredAt,
                            .registeredBy
                         )' \
                        backend-task-definition.json \
                        > backend-new-task-definition.json


                    echo "New Backend Task Definition:"
                    cat backend-new-task-definition.json
                '''
            }
        }


        // ============================================================
        // 11. CREATE NEW FRONTEND TASK DEFINITION
        // ============================================================

        stage('Create Frontend Task Definition') {
            steps {
                sh '''
                    echo "Getting current Frontend Task Definition..."

                    aws ecs describe-task-definition \
                        --task-definition ${FRONTEND_TASK_DEFINITION} \
                        --region ${AWS_REGION} \
                        --query taskDefinition \
                        --output json \
                        > frontend-task-definition.json


                    echo "Updating Frontend container image..."

                    jq --arg IMAGE "${FRONTEND_IMAGE}" \
                        '(.containerDefinitions[] |
                          select(.name == "frontend")).image = $IMAGE |
                         del(
                            .taskDefinitionArn,
                            .revision,
                            .status,
                            .requiresAttributes,
                            .compatibilities,
                            .registeredAt,
                            .registeredBy
                         )' \
                        frontend-task-definition.json \
                        > frontend-new-task-definition.json


                    echo "New Frontend Task Definition:"
                    cat frontend-new-task-definition.json
                '''
            }
        }


        // ============================================================
        // 12. REGISTER NEW BACKEND TASK DEFINITION REVISION
        // ============================================================

        stage('Register Backend Task Definition') {
            steps {
                sh '''
                    echo "Registering new Backend Task Definition..."

                    aws ecs register-task-definition \
                        --cli-input-json file://backend-new-task-definition.json \
                        --region ${AWS_REGION}

                    echo "Backend Task Definition registered successfully."
                '''
            }
        }


        // ============================================================
        // 13. REGISTER NEW FRONTEND TASK DEFINITION REVISION
        // ============================================================

        stage('Register Frontend Task Definition') {
            steps {
                sh '''
                    echo "Registering new Frontend Task Definition..."

                    aws ecs register-task-definition \
                        --cli-input-json file://frontend-new-task-definition.json \
                        --region ${AWS_REGION}

                    echo "Frontend Task Definition registered successfully."
                '''
            }
        }


        // ============================================================
        // 14. GET NEW BACKEND TASK DEFINITION REVISION
        // ============================================================

        stage('Get Backend Task Definition Revision') {
            steps {
                script {
                    def backendRevision = sh(
                        script: """
                            aws ecs describe-task-definition \
                                --task-definition ${BACKEND_TASK_DEFINITION} \
                                --region ${AWS_REGION} \
                                --query 'taskDefinition.revision' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    env.BACKEND_TASK_REVISION = backendRevision

                    echo "New Backend Task Definition Revision: ${backendRevision}"
                }
            }
        }


        // ============================================================
        // 15. GET NEW FRONTEND TASK DEFINITION REVISION
        // ============================================================

        stage('Get Frontend Task Definition Revision') {
            steps {
                script {
                    def frontendRevision = sh(
                        script: """
                            aws ecs describe-task-definition \
                                --task-definition ${FRONTEND_TASK_DEFINITION} \
                                --region ${AWS_REGION} \
                                --query 'taskDefinition.revision' \
                                --output text
                        """,
                        returnStdout: true
                    ).trim()

                    env.FRONTEND_TASK_REVISION = frontendRevision

                    echo "New Frontend Task Definition Revision: ${frontendRevision}"
                }
            }
        }


        // ============================================================
        // 16. DEPLOY BACKEND TO ECS
        // ============================================================

        stage('Deploy Backend') {
            steps {
                sh '''
                    echo "Deploying Backend to ECS..."

                    aws ecs update-service \
                        --cluster ${ECS_CLUSTER} \
                        --service ${BACKEND_SERVICE} \
                        --task-definition ${BACKEND_TASK_DEFINITION}:${BACKEND_TASK_REVISION} \
                        --region ${AWS_REGION}

                    echo "Backend deployment started."
                '''
            }
        }


        // ============================================================
        // 17. DEPLOY FRONTEND TO ECS
        // ============================================================

        stage('Deploy Frontend') {
            steps {
                sh '''
                    echo "Deploying Frontend to ECS..."

                    aws ecs update-service \
                        --cluster ${ECS_CLUSTER} \
                        --service ${FRONTEND_SERVICE} \
                        --task-definition ${FRONTEND_TASK_DEFINITION}:${FRONTEND_TASK_REVISION} \
                        --region ${AWS_REGION}

                    echo "Frontend deployment started."
                '''
            }
        }


        // ============================================================
        // 18. WAIT FOR ECS DEPLOYMENT
        // ============================================================

        stage('Wait for ECS Deployment') {
            steps {
                sh '''
                    echo "Waiting for ECS services to become stable..."

                    aws ecs wait services-stable \
                        --cluster ${ECS_CLUSTER} \
                        --services \
                            ${BACKEND_SERVICE} \
                            ${FRONTEND_SERVICE} \
                        --region ${AWS_REGION}

                    echo "ECS deployment completed successfully."
                '''
            }
        }


        // ============================================================
        // 19. SHOW DEPLOYED IMAGES
        // ============================================================

        stage('Deployment Summary') {
            steps {
                echo "=============================================="
                echo "           DEPLOYMENT SUCCESSFUL"
                echo "=============================================="

                echo "Backend Image:"
                echo "${BACKEND_IMAGE}"

                echo "Frontend Image:"
                echo "${FRONTEND_IMAGE}"

                echo "Backend Task Definition:"
                echo "${BACKEND_TASK_DEFINITION}:${BACKEND_TASK_REVISION}"

                echo "Frontend Task Definition:"
                echo "${FRONTEND_TASK_DEFINITION}:${FRONTEND_TASK_REVISION}"

                echo "=============================================="
            }
        }
    }


    // ================================================================
    // POST BUILD
    // ================================================================

    post {

        success {
            echo "=============================================="
            echo "ECS CI/CD PIPELINE SUCCESS"
            echo "=============================================="
        }

        failure {
            echo "=============================================="
            echo "ECS CI/CD PIPELINE FAILED"
            echo "Check the Jenkins console output."
            echo "=============================================="
        }

        always {
            echo "Pipeline finished."
        }
    }
}
